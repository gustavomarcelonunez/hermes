      <data key="d7">f02047988edd4a0f86b7df418c420828</data>
    </node>
    <node id="COSTA S. DEL GOLFO DE SAN JORGE">
      <data key="d0">NONE</data>
      <data key="d1">La Costa S. del Golfo de San Jorge es una regi&#243;n geogr&#225;fica que se extiende entre Punta Nava y Bah&#237;a Sanguineto, caracterizada por su topograf&#237;a y h&#225;bitats espec&#237;ficos.</data>
      <data key="d2">b936698b8bf77875919870e3152faf6d</data>
      <data key="d3">123</data>
