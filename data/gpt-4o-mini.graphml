      <data key="d6">197</data>
      <data key="d7">5556e20846924cabb22a52b51272e808</data>
    </node>
    <node id="LOBER&#205;AS PUNTA NINFAS">
      <data key="d0">PINNIPED</data>
      <data key="d1">Las lober&#237;as Punta Ninfas son zonas de reproducci&#243;n de lobos marinos, localizadas en la costa W. SW. de Punta Ninfas, con barrancas altas y vegetaci&#243;n t&#237;pica.</data>
      <data key="d2">45abddc2bb9e83effafbcae15de72d03</data>
