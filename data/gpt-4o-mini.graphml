    <node id="COSTA ARENOSA">
      <data key="d0">HABITAT</data>
      <data key="d1">La costa arenosa es un tipo de h&#225;bitat que se caracteriza por su arena y la falta de vegetaci&#243;n, donde los lobos marinos pueden descansar.</data>
      <data key="d2">b936698b8bf77875919870e3152faf6d</data>
      <data key="d3">124</data>
