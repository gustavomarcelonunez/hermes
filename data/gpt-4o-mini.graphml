      <data key="d5">5</data>
      <data key="d6">322</data>
      <data key="d7">a37c7f44409a4794b606df21b0f73712</data>
    </node>
    <node id="LOBER&#205;A &#8220;ISLA BECASSES&#8221;">
      <data key="d0">PINNIPED</data>
      <data key="d1">La lobera &#8220;Isla Becasses&#8221; es un grupo de islas donde se encuentra una poblaci&#243;n de lobos marinos, caracterizada por ser un sitio de reproducci&#243;n permanente y mixto, actualmente inexplotado.</data>
      <data key="d2">a4db5e0e4291abc5a30297f97a8ac533</data>
      <data key="d3">94</data>
      <data key="d4">1</data>
      <data key="d5">5</data>
      <data key="d6">323</data>
      <data key="d7">21963753527b407e9b9f3b7b6ee07136</data>
    </node>
    <node id="LOBER&#205;A &#8220;ISLA YUNQUE&#8221;">
      <data key="d0">PINNIPED</data>
      <data key="d1">La lobera &#8220;Isla Yunque&#8221; es un sitio de reproducci&#243;n temporal para lobos marinos, ubicado en el Canal de Beagle, con una topograf&#237;a de islote con vegetaci&#243;n.</data>
      <data key="d2">a4db5e0e4291abc5a30297f97a8ac533</data>
      <data key="d3">94</data>
      <data key="d4">1</data>
      <data key="d5">5</data>
      <data key="d6">324</data>
      <data key="d7">3a5df4db5dd54e4d979c089e34c152ad</data>
    </node>
    <node id="CR&#205;AS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Las cr&#237;as son los reci&#233;n nacidos de los lobos marinos, que dependen de sus madres para la alimentaci&#243;n y protecci&#243;n durante los primeros meses de vida.</data>
      <data key="d2">a4db5e0e4291abc5a30297f97a8ac533</data>
      <data key="d3">94</data>
      <data key="d4">1</data>
      <data key="d5">5</data>
      <data key="d6">325</data>
      <data key="d7">b649d6e5a074478e980974b2379034a3</data>
    </node>
    <node id="CANAL DE BEAGLE">
      <data key="d0">NONE</data>
      <data key="d1">El Canal de Beagle es un estrecho que separa la Isla Grande de Tierra del Fuego de las islas menores al sur, conocido por su biodiversidad marina y su importancia ecol&#243;gica.</data>
      <data key="d2">542231ad71887d5ea52f251bd5ce2e3e</data>
      <data key="d3">114</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">326</data>
      <data key="d7">28709732a4924dd79b3e147dd94b36c0</data>
    </node>
    <node id="ISLAS HERMANOS">
      <data key="d0">NONE</data>
      <data key="d1">Las Islas Hermanos son un grupo de islotes en el Canal de Beagle que son utilizados ocasionalmente por lobos marinos para descansar y reproducirse.</data>
      <data key="d2">542231ad71887d5ea52f251bd5ce2e3e</data>
      <data key="d3">114</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">327</data>
      <data key="d7">59020c00b45c43b78e0924247954408d</data>
    </node>
    <node id="CACHORROS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los cachorros son las cr&#237;as de los lobos marinos y elefantes marinos, que dependen de sus madres para la alimentaci&#243;n y protecci&#243;n durante sus primeros meses de vida.</data>
      <data key="d2">542231ad71887d5ea52f251bd5ce2e3e</data>
      <data key="d3">27</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">328</data>
      <data key="d7">8743d00b537c46d2bd25437b3cdc3bdf</data>
    </node>
    <node id="ISLOTE">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">542231ad71887d5ea52f251bd5ce2e3e</data>
      <data key="d3">114</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">329</data>
      <data key="d7">c34b5fd843e24bf3a1e3ae497cec88f2</data>
    </node>
    <node id="PUERTO ESTE SIN NOMBRE">
      <data key="d0">NONE</data>
      <data key="d1">Puerto Este Sin Nombre es un puerto en la regi&#243;n de Tierra del Fuego, que sirve como punto de partida para actividades de explotaci&#243;n marina.</data>
      <data key="d2">da6bf576b51c96c74aee885ecd44a5d3</data>
      <data key="d3">71</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">330</data>
      <data key="d7">f1581376ddb942659cfc6cfb88c62fd2</data>
    </node>
    <node id="CABO BUEN SUCESO">
      <data key="d0">NONE</data>
      <data key="d1">Cabo Buen Suceso es un cabo en Tierra del Fuego, conocido por su geograf&#237;a costera y su relevancia en la navegaci&#243;n y la explotaci&#243;n de recursos marinos.</data>
      <data key="d2">da6bf576b51c96c74aee885ecd44a5d3</data>
      <data key="d3">87</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">331</data>
      <data key="d7">8e5549cf6e824bfaafae2af9ad965c80</data>
    </node>
    <node id="PLANTAS DE INDUSTRIALIZACI&#211;N">
      <data key="d0">NONE</data>
      <data key="d1">Las plantas de industrializaci&#243;n son instalaciones donde se procesan los recursos marinos, como los lobos marinos, para la extracci&#243;n de productos como cuero y grasa.</data>
      <data key="d2">da6bf576b51c96c74aee885ecd44a5d3</data>
      <data key="d3">71</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">332</data>
      <data key="d7">d2b4f8e6b5ee4f6980106295bad36bb0</data>
    </node>
    <node id="CAPATAZ">
      <data key="d0">MAMMAL</data>
      <data key="d1">El capataz es el encargado de supervisar las actividades de los loberos en la explotaci&#243;n de lobos marinos, asegurando que las tareas se realicen de manera eficiente.</data>
      <data key="d2">da6bf576b51c96c74aee885ecd44a5d3</data>
      <data key="d3">75</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">333</data>
      <data key="d7">e72441b481294449b5f54929e833ea82</data>
    </node>
    <node id="LOBERO">
      <data key="d0">MAMMAL</data>
      <data key="d1">El lobero es el individuo especializado en la caza y explotaci&#243;n de lobos marinos, desempe&#241;ando un papel crucial en la industria pesquera de la regi&#243;n. Utiliza diversas t&#233;cnicas y herramientas para asegurar la captura de estos mam&#237;feros marinos, lo que refleja su conocimiento y habilidades en el manejo de estas especies. Su labor no solo es fundamental para la econom&#237;a local, sino que tambi&#233;n implica una comprensi&#243;n profunda de las din&#225;micas ecol&#243;gicas y la sostenibilidad de las poblaciones de lobos marinos en su h&#225;bitat.</data>
      <data key="d2">5b0c9bb6d4825c2ef5d5962d8392aad5,da6bf576b51c96c74aee885ecd44a5d3</data>
      <data key="d3">75</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">334</data>
      <data key="d7">6dd0805e32f540489cbd957535f0dcb7</data>
    </node>
    <node id="COMPARSA">
      <data key="d0">NONE</data>
      <data key="d1">La comparsa es el grupo de loberos que trabajan juntos en la caza y explotaci&#243;n de lobos marinos, coordinando sus esfuerzos para maximizar la eficiencia.</data>
      <data key="d2">da6bf576b51c96c74aee885ecd44a5d3</data>
      <data key="d3">75</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">335</data>
      <data key="d7">45c9de26b5c04e74aca357c286b18204</data>
    </node>
    <node id="PI&#209;O">
      <data key="d0">NONE</data>
      <data key="d1">El pi&#241;o es un grupo espec&#237;fico de lobos marinos que se separa de la manada durante la caza, lo que puede resultar en un proceso complicado y arriesgado para los loberos. Este grupo se selecciona de la manada y est&#225; compuesto por un n&#250;mero variable de animales, lo que indica que su tama&#241;o puede fluctuar dependiendo de las circunstancias de la caza. La din&#225;mica del pi&#241;o refleja las complejas interacciones sociales y de caza dentro de las poblaciones de lobos marinos, destacando la importancia de la cooperaci&#243;n y la estrategia en su comportamiento.</data>
      <data key="d2">5b0c9bb6d4825c2ef5d5962d8392aad5,da6bf576b51c96c74aee885ecd44a5d3</data>
      <data key="d3">114</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">336</data>
      <data key="d7">4466c49005a845998f6961a3c9b59a3e</data>
    </node>
    <node id="EXTRACCI&#211;N Y APROVECHAMIENTO">
      <data key="d0">NONE</data>
      <data key="d1">La extracci&#243;n y aprovechamiento se refieren a los procesos industriales utilizados para obtener productos de los lobos marinos, como cuero y grasa.</data>
      <data key="d2">da6bf576b51c96c74aee885ecd44a5d3</data>
      <data key="d3">114</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">337</data>
      <data key="d7">2617e52c467b4067af297a4fcbfc8b09</data>
    </node>
    <node id="HAREM">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">El harem es una estructura social dentro de las manadas de lobos marinos, compuesta por un n&#250;mero variable de individuos. En este contexto, los machos adultos desempe&#241;an un papel dominante, liderando y protegiendo al grupo. Espec&#237;ficamente, un harem de lobos marinos de un pelo se caracteriza por la presencia de un macho que se aparea con varias hembras del grupo, lo que resalta la din&#225;mica reproductiva y social de esta especie. Esta organizaci&#243;n social es fundamental para la reproducci&#243;n y la supervivencia de los lobos marinos, ya que permite la formaci&#243;n de v&#237;nculos entre los machos y las hembras, as&#237; como la defensa del territorio frente a otros machos.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d,5b0c9bb6d4825c2ef5d5962d8392aad5</data>
      <data key="d3">31</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">338</data>
      <data key="d7">32e49287991b474d88cbe88da5c0a4a4</data>
    </node>
    <node id="MATANZA">
      <data key="d0">NONE</data>
      <data key="d1">La matanza se refiere al proceso de caza y sacrificio de lobos marinos, que implica t&#233;cnicas espec&#237;ficas para asegurar una muerte r&#225;pida y efectiva.</data>
      <data key="d2">5b0c9bb6d4825c2ef5d5962d8392aad5</data>
      <data key="d3">75</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">339</data>
      <data key="d7">f4cd39ca6dad443c8776b19aa92ef23e</data>
    </node>
    <node id="CORTES">
      <data key="d0">NONE</data>
      <data key="d1">Los cortes son las separaciones que se realizan durante la caza de lobos marinos, donde se intenta controlar el movimiento de los animales para facilitar su captura.</data>
      <data key="d2">5b0c9bb6d4825c2ef5d5962d8392aad5</data>
      <data key="d3">114</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">340</data>
      <data key="d7">3e5bcfb97caa434e86247e1df58ab0cb</data>
    </node>
    <node id="REGI&#211;N PARIETAL">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">La regi&#243;n parietal es una parte del cr&#225;neo del lobo marino que es objetivo durante el proceso de caza, donde se busca aturdir al animal.</data>
      <data key="d2">5b0c9bb6d4825c2ef5d5962d8392aad5</data>
      <data key="d3">114</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">341</data>
      <data key="d7">27910e36da26429ea0450df0cb51adef</data>
    </node>
    <node id="PUNTA DE LANZA">
      <data key="d0">NONE</data>
      <data key="d1">La punta de lanza se refiere a la formaci&#243;n de lobos marinos que intentan escapar del acoso humano, liderados por los machos adultos m&#225;s corpulentos.</data>
      <data key="d2">5b0c9bb6d4825c2ef5d5962d8392aad5</data>
      <data key="d3">114</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">342</data>
      <data key="d7">fa0e268a16dd4d04a5038bec74985751</data>
    </node>
    <node id="CUERO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El "CUERO" se refiere a la piel de un animal que se extrae y se procesa para su uso en diversas industrias, siendo un material valioso en la peleter&#237;a y talabarter&#237;a. En particular, el cuero de ping&#252;ino es un tipo espec&#237;fico de cuero obtenido de la piel de estos animales. Aunque hist&#243;ricamente se ha utilizado en la confecci&#243;n de diversos art&#237;culos, actualmente carece de cotizaci&#243;n en el comercio interior, lo que sugiere una disminuci&#243;n en su demanda o en su uso comercial. Esta situaci&#243;n refleja un cambio en las pr&#225;cticas de consumo y en la valoraci&#243;n de materiales provenientes de especies espec&#237;ficas, como los ping&#252;inos.</data>
      <data key="d2">249c41297ac140d235ac5afb097528b7,c0e82041e872b7b6fe0dc4899137a71d</data>
      <data key="d3">67</data>
      <data key="d4">1</data>
      <data key="d5">8</data>
      <data key="d6">343</data>
      <data key="d7">c643746b68c84f89a9099b4b3c360658</data>
    </node>
    <node id="SAL">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">La sal es un compuesto qu&#237;mico utilizado en la conservaci&#243;n de cueros, actuando para deshidratar y preservar los tejidos de los animales.</data>
      <data key="d2">249c41297ac140d235ac5afb097528b7</data>
      <data key="d5">1</data>
      <data key="d6">344</data>
      <data key="d7">6b1d033f75f24083b7691a2b94ee8aed</data>
    </node>
    <node id="PROCEDIMIENTO DE CONSERVACI&#211;N">
      <data key="d0">NONE</data>
      <data key="d1">El procedimiento de conservaci&#243;n de los cueros implica el uso de sal para deshidratar y preservar la piel, asegurando su calidad para el uso industrial.</data>
      <data key="d2">249c41297ac140d235ac5afb097528b7</data>
      <data key="d5">1</data>
      <data key="d6">345</data>
      <data key="d7">de6b170325464941bb9daca41bbf8445</data>
    </node>
    <node id="FICHADO">
      <data key="d0">NONE</data>
      <data key="d1">El fichado es el proceso de separar el tejido graso del cuero, realizado por personal especializado que utiliza cuchillas para preparar el cuero para su tratamiento.</data>
      <data key="d2">249c41297ac140d235ac5afb097528b7</data>
      <data key="d3">67</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">346</data>
      <data key="d7">80201fcf7d4c4e4db0cd239e3394e8b2</data>
    </node>
    <node id="MATRIZ ADIPOSA">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">La matriz adiposa es el tejido graso que se encuentra bajo la piel de los animales, que puede ser extra&#237;do durante el proceso de fichado del cuero.</data>
      <data key="d2">249c41297ac140d235ac5afb097528b7</data>
      <data key="d3">67</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">347</data>
      <data key="d7">f9873cd71e6948feaca80951df41a64a</data>
    </node>
    <node id="CUERO FICHADO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El cuero fichado es el resultado del proceso de fichado, donde se ha separado el tejido graso, dej&#225;ndolo listo para su tratamiento y uso industrial.</data>
      <data key="d2">249c41297ac140d235ac5afb097528b7</data>
      <data key="d3">67</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">348</data>
      <data key="d7">9507ab1fac9c420c9e208bfd8ba3b42b</data>
    </node>
    <node id="CUEROS SIN FICHAR">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los cueros sin fichar son aquellos que no han sido sometidos al proceso de fichado, manteniendo el tejido graso adherido a la piel.</data>
      <data key="d2">249c41297ac140d235ac5afb097528b7</data>
      <data key="d3">67</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">349</data>
      <data key="d7">9e1cbeec752f4fab97a14ab2aaacf56c</data>
    </node>
    <node id="CUEROS FICHADOS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los cueros fichados son aquellos que han sido procesados para eliminar el tejido graso, siendo m&#225;s ligeros y listos para su conservaci&#243;n y uso.</data>
      <data key="d2">249c41297ac140d235ac5afb097528b7</data>
      <data key="d3">67</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">350</data>
      <data key="d7">cdcc9205ecda4e1ea310e6e507e540df</data>
    </node>
    <node id="ANIMALES CA&#205;DOS">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">249c41297ac140d235ac5afb097528b7</data>
      <data key="d3">73</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">351</data>
      <data key="d7">c2a053d32406443daf2734b9ed145c61</data>
    </node>
    <node id="SALAZ&#211;N">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">La entidad "SALAZ&#211;N" se refiere a un m&#233;todo de conservaci&#243;n de alimentos que se aplica a productos derivados de pinn&#237;pedos, como el aceite de lobo. Este proceso de salaz&#243;n es un procedimiento f&#237;sico-qu&#237;mico que utiliza cloruro de sodio para conservar la piel de los animales. Durante este proceso, el cloruro de sodio penetra en los tejidos, desplazando el agua contenida en ellos, lo que permite una mejor preservaci&#243;n de los productos.</data>
      <data key="d2">55cd91801b46fb522e3565c9e40ffb77,f8c808023073060b786c4366da9733ff</data>
      <data key="d3">21</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">352</data>
      <data key="d7">8cd2a4061bc2420cba8acd67bc879985</data>
    </node>
    <node id="CUEROS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los cueros son la piel de los animales que se someten a un proceso de salaz&#243;n para su conservaci&#243;n, variando en peso y longitud seg&#250;n el tipo de animal y el proceso aplicado. En particular, los cueros de lobos marinos son pieles tratadas que se utilizan en diversas industrias, como la talabarter&#237;a y marroquiner&#237;a. Estos cueros son productos derivados de los lobos marinos que son recolectados durante la caza y poseen un valor comercial significativo.</data>
      <data key="d2">583f551deb29bf66f80bcf97f89e3c64,929b52dcc39f3e79e12fe7e15557dbaf,f8c808023073060b786c4366da9733ff</data>
      <data key="d3">19</data>
      <data key="d4">1</data>
      <data key="d5">14</data>
      <data key="d6">353</data>
      <data key="d7">a47964ccfb99419ab0181b333a2054bc</data>
    </node>
    <node id="SALMUERA">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">La salmuera es una soluci&#243;n de sal en agua que se utiliza en el proceso de salaz&#243;n para conservar los cueros, siendo importante controlar su concentraci&#243;n.</data>
      <data key="d2">f8c808023073060b786c4366da9733ff</data>
      <data key="d3">19</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">354</data>
      <data key="d7">04a32927113f46e1a03304f579c1839a</data>
    </node>
    <node id="SALADO SECO">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">El salado seco es un m&#233;todo de conservaci&#243;n de cueros que se realiza simult&#225;neamente con el estibado, utilizando sal de grano mediano para asegurar la conservaci&#243;n.</data>
      <data key="d2">f8c808023073060b786c4366da9733ff</data>
      <data key="d3">19</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">355</data>
      <data key="d7">1fbb1117a1da40b7a2064afcd9afa188</data>
    </node>
    <node id="ESTIBADO">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">El estibado es el proceso de apilar cueros salados en capas alternadas con sal, permitiendo que el conservante act&#250;e de manera uniforme sobre la superficie de los cueros.</data>
      <data key="d2">f8c808023073060b786c4366da9733ff</data>
      <data key="d3">19</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">356</data>
      <data key="d7">3b1f329aa9b44c29aa6df5491d921136</data>
    </node>
    <node id="SALADOR">
      <data key="d0">MAMMAL</data>
      <data key="d1">El salador es la persona encargada de realizar las tareas de salaz&#243;n y estibado de los cueros, utilizando guantes protectores para evitar da&#241;os por la sal.</data>
      <data key="d2">f8c808023073060b786c4366da9733ff</data>
      <data key="d3">21</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">357</data>
      <data key="d7">a082208fd4fa4d25a6e5fffb9dd516ab</data>
    </node>
    <node id="TRANSPORTE">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">El transporte es el proceso mediante el cual los cueros salados son llevados a su destino, generalmente a la Capital Federal, para su posterior curtido.</data>
      <data key="d2">f8c808023073060b786c4366da9733ff</data>
      <data key="d3">19</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">358</data>
      <data key="d7">84d876c54f234338a1ea11b51a9c3d47</data>
    </node>
    <node id="ANIMALES ADULTOS GRANDES">
      <data key="d0">MAMMAL</data>
      <data key="d1">Los animales adultos grandes son mam&#237;feros marinos que producen cueros de mayor tama&#241;o, utilizados en la industria de la conservaci&#243;n y curtido.</data>
      <data key="d2">f8c808023073060b786c4366da9733ff</data>
      <data key="d3">19</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">359</data>
      <data key="d7">97eb7420201d4734b736420a0c5b69cf</data>
    </node>
    <node id="CURTIDO">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">El "curtido" es un proceso esencial en la transformaci&#243;n de la piel animal en cuero, que implica varios m&#233;todos de tratamiento. Este proceso no solo se enfoca en la conversi&#243;n de la piel, sino que tambi&#233;n busca mejorar la durabilidad y la apariencia del cuero resultante. Entre las t&#233;cnicas utilizadas, se incluye el uso de aceites de lobo marino, lo que puede aportar propiedades espec&#237;ficas al material. El curtido se lleva a cabo despu&#233;s de la salaz&#243;n, donde las pieles son tratadas para asegurar que se conviertan en un producto final duradero y utilizable. En resumen, el curtido es un proceso clave que combina t&#233;cnicas tradicionales y materiales espec&#237;ficos para optimizar la calidad del cuero.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6,583f551deb29bf66f80bcf97f89e3c64,f8c808023073060b786c4366da9733ff</data>
      <data key="d3">18</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">360</data>
      <data key="d7">23e75f2b44fa4728825dbf531b838243</data>
    </node>
    <node id="L&#205;OS">
      <data key="d0">NONE</data>
      <data key="d1">Los l&#237;os son agrupaciones de cueros de lobos marinos, que se disponen en unidades de 2 y 4 para su transporte y comercializaci&#243;n.</data>
      <data key="d2">583f551deb29bf66f80bcf97f89e3c64</data>
      <data key="d3">19</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">361</data>
      <data key="d7">1c94a0d84b854a96b4be5d8ad7ebdd68</data>
    </node>
    <node id="ACEITE">
      <data key="d0">NONE</data>
      <data key="d1">El "ACEITE" se refiere a productos derivados de la grasa de especies marinas, espec&#237;ficamente el aceite de lobo marino y el aceite de ping&#252;ino. El aceite de lobo marino se utiliza en la industria del curtido, siendo su extracci&#243;n parte de la explotaci&#243;n de esta especie. Por otro lado, el aceite de ping&#252;ino, que tambi&#233;n se obtiene de la grasa de estos animales, se emplea en el curtido de cueros y en diversas aplicaciones industriales, presentando caracter&#237;sticas qu&#237;micas similares a otros aceites marinos. En resumen, ambos tipos de aceite son subproductos de la grasa de especies marinas y tienen un papel importante en la industria, especialmente en el curtido de cueros.</data>
      <data key="d2">144ccee104076cb699414480fca2f46b,583f551deb29bf66f80bcf97f89e3c64,c0e82041e872b7b6fe0dc4899137a71d</data>
      <data key="d3">113</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">362</data>
      <data key="d7">45ccdb4e325e435d9acfd4a26e176706</data>
    </node>
    <node id="EXPORTACI&#211;N">
      <data key="d0">NONE</data>
      <data key="d1">La EXPORTACI&#211;N se refiere al proceso de enviar productos, espec&#237;ficamente cueros de lobos marinos, a mercados internacionales. Este proceso incluye el env&#237;o a pa&#237;ses como Estados Unidos, donde existe una alta demanda, as&#237; como a otros mercados como Noruega y Sud&#225;frica. La actividad de exportaci&#243;n es fundamental para satisfacer las necesidades del mercado internacional y puede tener implicaciones significativas en la econom&#237;a local y en la conservaci&#243;n de las especies involucradas.</data>
      <data key="d2">583f551deb29bf66f80bcf97f89e3c64,79d9c36d47673af84dba65217ceaddec</data>
      <data key="d3">20</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">363</data>
      <data key="d7">eed85c318bf74ce3b859d553750fabfe</data>
    </node>
    <node id="MERCADO INTERNO">
      <data key="d0">NONE</data>
      <data key="d1">El "MERCADO INTERNO" se define como el sistema de compra y venta de productos dentro de un pa&#237;s, abarcando la totalidad de la producci&#243;n de cueros de lobos marinos. Adem&#225;s, este mercado tambi&#233;n se refiere a la demanda de guano de aves marinas, que actualmente absorbe toda la producci&#243;n nacional sin que existan exportaciones significativas. En conjunto, el mercado interno juega un papel crucial en la econom&#237;a local al integrar la producci&#243;n de estos recursos marinos y satisfacer la demanda interna.</data>
      <data key="d2">583f551deb29bf66f80bcf97f89e3c64,f058a062f571d1de67aa67b3be3adee4</data>
      <data key="d3">51</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">364</data>
      <data key="d7">0cffad4aee444d92a007f6f0d0052c79</data>
    </node>
    <node id="GRASA">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">La grasa es un subproducto obtenido de los lobos marinos, que se utiliza para la producci&#243;n de aceite y otros productos industriales.</data>
      <data key="d2">583f551deb29bf66f80bcf97f89e3c64</data>
      <data key="d3">114</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">365</data>
      <data key="d7">792667c2172441fbb221200998bd22ed</data>
    </node>
    <node id="VALOR COMERCIAL">
      <data key="d0">NONE</data>
      <data key="d1">El valor comercial se refiere al precio de mercado de los cueros de lobos marinos, que fluct&#250;a seg&#250;n la oferta y la demanda.</data>
      <data key="d2">583f551deb29bf66f80bcf97f89e3c64</data>
      <data key="d3">19</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">366</data>
      <data key="d7">73beb3bc78ef4be580985b36587eae0d</data>
    </node>
    <node id="CUERO DE LOBO MARINO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El cuero de lobo marino es el material obtenido de la piel de los lobos marinos, utilizado en la fabricaci&#243;n de productos diversos.</data>
      <data key="d2">103d13f2a7d5f4c20fac4a64966b8fde</data>
      <data key="d3">114</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">367</data>
      <data key="d7">12b67fc98de04a509a6f3caf43d8901c</data>
    </node>
    <node id="PROCEDIMIENTO POR VAPOR DIRECTO A PRESI&#211;N">
      <data key="d0">RESEARCH</data>
      <data key="d1">El procedimiento por vapor directo a presi&#243;n es un m&#233;todo utilizado para extraer aceite de los lobos marinos, que implica el uso de calderas y recipientes a presi&#243;n.</data>
      <data key="d2">103d13f2a7d5f4c20fac4a64966b8fde</data>
      <data key="d3">71</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">368</data>
      <data key="d7">1c52548d164948c086e3c1e0a5f05467</data>
    </node>
    <node id="ACEITE DE LOBOS MARINOS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El aceite de lobos marinos es un producto obtenido a trav&#233;s de un proceso de cocci&#243;n y extracci&#243;n, caracterizado por su calidad y propiedades espec&#237;ficas derivadas de la grasa de estos animales.</data>
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d3">58</data>
      <data key="d4">1</data>
      <data key="d5">5</data>
      <data key="d6">369</data>
      <data key="d7">eea7925ab2bb4b3aaa0c21d720e71060</data>
    </node>
    <node id="DIGESTORES">
      <data key="d0">NONE</data>
      <data key="d1">Los digestores son c&#225;maras de cocci&#243;n utilizadas en el proceso de extracci&#243;n de aceite, donde se inyecta vapor y se controla la presi&#243;n y temperatura para obtener el producto final.</data>
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d3">59</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">370</data>
      <data key="d7">dda89ef509c14528b12cd0b5cb218e2e</data>
    </node>
    <node id="CHICHARR&#211;N">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El chicharr&#243;n es el residuo de tejido graso que queda despu&#233;s del proceso de extracci&#243;n de aceite, caracterizado por su aspecto esponjoso y d&#233;bil consistencia.</data>
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d3">60</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">371</data>
      <data key="d7">417ea4ad3720489aa9adc8bd2492beaa</data>
    </node>
    <node id="R&#211;BALOS">
      <data key="d0">SPECIES</data>
      <data key="d1">Los r&#243;balos son peces que se alimentan de los restos de tejido graso que se transportan a la playa, contribuyendo al ciclo de limpieza del ecosistema marino.</data>
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d3">60</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">372</data>
      <data key="d7">8c4f26cb941046cd8c8b7044a67fb172</data>
    </node>
    <node id="PEJERREYES">
      <data key="d0">SPECIES</data>
      <data key="d1">Los pejerreyes son otro tipo de pez que tambi&#233;n se alimenta de los restos dejados en la playa tras el proceso de extracci&#243;n de aceite de lobos marinos.</data>
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d3">60</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">373</data>
      <data key="d7">7edddde92e6246f1b5040c181032b6b5</data>
    </node>
    <node id="AGUA">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El agua es un recurso esencial utilizado en el proceso de carga y alimentaci&#243;n de la caldera, proveniente de las lluvias y almacenada para tal uso.</data>
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d5">1</data>
      <data key="d6">374</data>
      <data key="d7">74489caa4bf34b6f917e927d70978153</data>
    </node>
    <node id="TEMPERATURA">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">La temperatura es un factor cr&#237;tico que debe ser controlado durante el proceso de cocci&#243;n en los digestores, ya que un exceso puede afectar la calidad del producto.</data>
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d3">59</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">375</data>
      <data key="d7">de7788b2bbc24c6180eb41bacbb26e2c</data>
    </node>
    <node id="PRESI&#211;N">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">La presi&#243;n es un aspecto importante en el funcionamiento de los digestores, ya que un exceso puede provocar accidentes y afectar el proceso de extracci&#243;n de aceite.</data>
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d3">59</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">376</data>
      <data key="d7">30fb1cb0ca2949c190f315c237f46cf8</data>
    </node>
    <node id="TANQUE DEP&#211;SITO">
      <data key="d0">NONE</data>
      <data key="d1">El tanque dep&#243;sito es el recipiente donde se enfr&#237;a y almacena el aceite obtenido tras el proceso de extracci&#243;n, antes de ser envasado.</data>
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d3">58</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">377</data>
      <data key="d7">09aad1c93c3b4aa593e1bf0bc46402f2</data>
    </node>
    <node id="ENVASADO">
      <data key="d0">NONE</data>
      <data key="d1">El envasado es el proceso de colocar el aceite en tambores o recipientes para su almacenamiento y transporte, asegurando que se mantenga en condiciones adecuadas.</data>
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d3">58</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">378</data>
      <data key="d7">059f3e91ea2645928e2f1796e2f59c75</data>
    </node>
    <node id="TAMBORES DE HIERRO">
      <data key="d0">NONE</data>
      <data key="d1">Los tambores de hierro son recipientes utilizados para el envasado del aceite, con una capacidad aproximada de 200 kilos, que se pintan y etiquetan antes del embarque.</data>
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d3">58</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">379</data>
      <data key="d7">7dddc280f2ff4642a08afd369b8430ca</data>
    </node>
    <node id="CALIDADES Y TIPOS DE ACEITE">
      <data key="d0">CONSERVATION STATUS</data>
      <data key="d1">Las calidades y tipos de aceite de lobos marinos se refieren a las variaciones en la calidad del aceite obtenido, dependiendo de factores como el m&#233;todo de extracci&#243;n y las caracter&#237;sticas de los animales.</data>
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d3">58</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">380</data>
      <data key="d7">31060824a8944746885e10abff7be13c</data>
    </node>
    <node id="BOMBA-RELOJ">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d5">1</data>
      <data key="d6">381</data>
      <data key="d7">b8e19d1cba6c4608b89a799a68438020</data>
    </node>
    <node id="ACEITE DE LOMO MARINO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El aceite de lobo marino es un l&#237;quido turbio, de color amarillo &#225;mbar, con un olor caracter&#237;stico a lobo, que se obtiene de los machos adultos de m&#225;s de 5 a&#241;os de edad y tiene diversas calidades seg&#250;n el procedimiento de extracci&#243;n.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">22</data>
      <data key="d4">1</data>
      <data key="d5">8</data>
      <data key="d6">382</data>
      <data key="d7">c82e240f3f834ad3ad1ec75ae69172ac</data>
    </node>
    <node id="ACEITE TIPO 1">
      <data key="d0">CONSERVATION STATUS</data>
      <data key="d1">El aceite tipo 1 es de la mejor calidad, con bajo tenor &#225;cido y densidad, y se obtiene de los lobo marinos, siendo el m&#225;s valorado en el mercado.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">22</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">383</data>
      <data key="d7">8d51d50072d44d9f80f70247a200cb17</data>
    </node>
    <node id="ACEITE TIPO 2">
      <data key="d0">CONSERVATION STATUS</data>
      <data key="d1">El aceite tipo 2 es de calidad intermedia, con caracter&#237;sticas similares al tipo 1, pero con un color m&#225;s rojizo y un olor m&#225;s pronunciado.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">22</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">384</data>
      <data key="d7">7944d8fe9d0d4b6ba11e267b2180ffc1</data>
    </node>
    <node id="ACEITE TIPO 3">
      <data key="d0">CONSERVATION STATUS</data>
      <data key="d1">El aceite tipo 3 es de calidad inferior, con un color rojizo y un olor fuerte, y presenta mayores niveles de acidez y densidad.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">22</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">385</data>
      <data key="d7">e9bfe72352524e0cb01fbede25133d00</data>
    </node>
    <node id="ACEITE REFINADO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El aceite refinado es un l&#237;quido l&#237;mpido y transparente, tratado qu&#237;micamente para extraer estearina, con un olor no muy pronunciado.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">24</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">386</data>
      <data key="d7">3ddf79387a44492ea0d1caca29e4ef3f</data>
    </node>
    <node id="ACEITE SULFONADO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El aceite sulfonado es un l&#237;quido de color rojizo, m&#225;s denso y turbio que el aceite refinado, con caracter&#237;sticas espec&#237;ficas de olor y apariencia.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">24</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">387</data>
      <data key="d7">dfc51a439cba4cd38b5a1dc59ef7d602</data>
    </node>
    <node id="ACEITE OXIDADO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El "ACEITE OXIDADO" es un tipo de aceite que ha experimentado un proceso de oxidaci&#243;n, lo que provoca un cambio en sus propiedades qu&#237;micas y f&#237;sicas en comparaci&#243;n con el aceite natural. Este aceite se presenta como un l&#237;quido viscoso y espeso, de color amarillo canela, y se caracteriza por un fuerte olor distintivo. Se obtiene a trav&#233;s de procedimientos especiales del aceite de lobo marino, lo que sugiere un v&#237;nculo con la biolog&#237;a marina y la utilizaci&#243;n de recursos marinos en su producci&#243;n.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6,db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">23</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">388</data>
      <data key="d7">4559c231b7254341acc54e84dbd84132</data>
    </node>
    <node id="RESERVAS GRASAS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Las reservas grasas son acumulaciones de grasa en el cuerpo de los lobo marinos, que influyen en el rendimiento del aceite obtenido.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">25</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">389</data>
      <data key="d7">72ce5eda08034026b3933fc084e99073</data>
    </node>
    <node id="PESO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El peso es una caracter&#237;stica f&#237;sica de los lobo marinos que afecta la cantidad de aceite que se puede extraer de ellos.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">25</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">390</data>
      <data key="d7">764ea5e88c66432c9438a462894b16e9</data>
    </node>
    <node id="CALIDADES DEL ACEITE">
      <data key="d0">CONSERVATION STATUS</data>
      <data key="d1">Las calidades del aceite se refieren a las diferentes clasificaciones del aceite de lobo marino, que var&#237;an seg&#250;n el tipo de extracci&#243;n y las caracter&#237;sticas del producto final.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">22</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">391</data>
      <data key="d7">0310d5f87da7444cba96f0aaf07cad68</data>
    </node>
    <node id="PROCEDIMIENTO DE EXTRACCI&#211;N">
      <data key="d0">RESEARCH</data>
      <data key="d1">El procedimiento de extracci&#243;n es el m&#233;todo utilizado para obtener el aceite de lobo marino, que puede influir en la calidad del producto final.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">22</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">392</data>
      <data key="d7">94433aec016b4532b3c711702c500336</data>
    </node>
    <node id="MACHOS ADULTOS">
      <data key="d0" />
      <data key="d1">Los machos adultos son lobos marinos de sexo masculino que pueden ser cazados bajo regulaciones espec&#237;ficas, especialmente durante la temporada de caza. Esta pr&#225;ctica est&#225; sujeta a normativas que buscan asegurar la sostenibilidad de la poblaci&#243;n de lobos marinos y proteger el equilibrio del ecosistema marino en el que habitan.</data>
      <data key="d2">929b52dcc39f3e79e12fe7e15557dbaf,db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">25</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">393</data>
      <data key="d7">cdc1dd1f777a4187b364fd15c3797918</data>
    </node>
    <node id="INDUSTRIA DEL CUERO">
      <data key="d0">NONE</data>
      <data key="d1">La industria del cuero es un sector que utiliza productos como el aceite de lobo marino y el cuero de lobos marinos y elefantes marinos para la fabricaci&#243;n de diversos art&#237;culos.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d3">69</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">394</data>
      <data key="d7">8b3dc2d25d484384b31d08a3bf95440e</data>
    </node>
    <node id="PRODUCCI&#211;N">
      <data key="d0">NONE</data>
      <data key="d1">La producci&#243;n se refiere a la cantidad de cueros y aceite obtenidos de lobos marinos y elefantes marinos durante un per&#237;odo espec&#237;fico, como se detalla en las cifras de producci&#243;n de 1945 a 1948.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d3">70</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">395</data>
      <data key="d7">1789840b52924a1c90a59d30b5c5d752</data>
    </node>
    <node id="SULFONADO">
      <data key="d0">NONE</data>
      <data key="d1">El sulfonado es un tipo de tratamiento qu&#237;mico aplicado a los cueros que mejora su capacidad de penetraci&#243;n y flexibilidad, utilizando aceites tratados.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d3">18</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">396</data>
      <data key="d7">d113d568e5f3444da97a409c0da66558</data>
    </node>
    <node id="AGUAS DURAS">
      <data key="d0">NONE</data>
      <data key="d1">Las aguas duras son aquellas que contienen altos niveles de minerales, utilizadas en el proceso de curtido de cueros, afectando la calidad del producto final.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d3">18</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">397</data>
      <data key="d7">57a65e16509449e4b409514278d058a7</data>
    </node>
    <node id="NUTRICI&#211;N">
      <data key="d0">NONE</data>
      <data key="d1">La nutrici&#243;n en el contexto del curtido se refiere a uno de los &#250;ltimos tratamientos aplicados a los cueros para mejorar su flexibilidad y eliminar la rigidez.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d3">69</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">398</data>
      <data key="d7">9f1fe524793346c3bb79978d312eebb5</data>
    </node>
    <node id="DEGRAS">
      <data key="d0">NONE</data>
      <data key="d1">El degras es un subproducto del proceso de curtido que se obtiene al utilizar aceites en el tratamiento de cueros, especialmente de carnero.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d3">18</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">399</data>
      <data key="d7">2e3e2b0a3a604269b5e5fc55478cf0aa</data>
    </node>
    <node id="ACEITE NATURAL">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d3">23</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">400</data>
      <data key="d7">404a5f239e0e4b0c8022c4cebad96550</data>
    </node>
    <node id="LOBOS DE DOS PELOS">
      <data key="d0">PINNIPED</data>
      <data key="d1">Los lobos de dos pelos (Arctocephalus australis) son otra especie de pinn&#237;pedo que se encuentra en el hemisferio sur, conocidos por su capacidad de adaptaci&#243;n a diferentes h&#225;bitats marinos.</data>
      <data key="d2">79d9c36d47673af84dba65217ceaddec</data>
      <data key="d3">98</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">401</data>
      <data key="d7">3553b7c1835041d193e9ebed05c7c684</data>
    </node>
    <node id="DISPOSICIONES DE CAR&#193;CTER NACIONAL">
      <data key="d0">NONE</data>
      <data key="d1">Las disposiciones de car&#225;cter nacional regulan las actividades industriales sobre el aprovechamiento de lobos marinos y elefantes marinos, estableciendo normas para su caza y comercializaci&#243;n.</data>
      <data key="d2">79d9c36d47673af84dba65217ceaddec</data>
      <data key="d3">27</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">402</data>
      <data key="d7">e174c7ad2db84870906ca9979953535b</data>
    </node>
    <node id="CIFRAS DE PRODUCCI&#211;N">
      <data key="d0">NONE</data>
      <data key="d1">Las cifras de producci&#243;n de cueros de lobos marinos de un pelo entre 1945 y 1948 muestran la cantidad de unidades producidas y exportadas, destacando los a&#241;os 1945 y 1946.</data>
      <data key="d2">79d9c36d47673af84dba65217ceaddec</data>
      <data key="d5">0</data>
      <data key="d6">403</data>
      <data key="d7">dc56f299a7894791ae694706c31835aa</data>
    </node>
    <node id="PERMISOS PROVISONALES">
      <data key="d0">NONE</data>
      <data key="d1">Los permisos provisionales son autorizaciones otorgadas por el Ministerio de Agricultura para cazar y faenar lobos marinos, regulando su explotaci&#243;n.</data>
      <data key="d2">79d9c36d47673af84dba65217ceaddec</data>
      <data key="d3">30</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">404</data>
      <data key="d7">0e9db83d1b17466495993f8170653123</data>
    </node>
    <node id="DECRETO N.&#186; 1154">
      <data key="d0">NONE</data>
      <data key="d1">El Decreto N.&#186; 1154 es una normativa que regula la caza y explotaci&#243;n de lobos marinos en Argentina, estableciendo condiciones y restricciones para su manejo.</data>
      <data key="d2">79d9c36d47673af84dba65217ceaddec</data>
      <data key="d3">30</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">405</data>
      <data key="d7">dfe6341d2c50408b955b12f1c874fd5f</data>
    </node>
    <node id="DECRETO N&#176; 56844">
      <data key="d0">NONE</data>
      <data key="d1">El Decreto N&#176; 56844 es una resoluci&#243;n que regula las actividades relacionadas con la caza y la industrializaci&#243;n de lobos marinos de un pelo en Argentina.</data>
      <data key="d2">79d9c36d47673af84dba65217ceaddec</data>
      <data key="d3">26</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">406</data>
      <data key="d7">fd56e794468641a6babe6f35b2ebca73</data>
    </node>
    <node id="ZONAS DE DESCANSO">
      <data key="d0">HABITAT</data>
      <data key="d1">Las zonas de descanso son &#225;reas donde los lobos marinos se agrupan para descansar y que deben ser protegidas de actividades humanas durante ciertos per&#237;odos.</data>
      <data key="d2">79d9c36d47673af84dba65217ceaddec</data>
      <data key="d3">26</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">407</data>
      <data key="d7">cc41dcbbc02941519409fe361977d1a9</data>
    </node>
    <node id="CAMPA&#209;AS DE A&#209;OS ANTERIORES">
      <data key="d0">NONE</data>
      <data key="d1">Las campa&#241;as de a&#241;os anteriores se refieren a las actividades de caza y producci&#243;n de cueros realizadas en a&#241;os previos a 1945, que influyen en las cifras actuales.</data>
      <data key="d2">79d9c36d47673af84dba65217ceaddec</data>
      <data key="d3">20</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">408</data>
      <data key="d7">a3737762b79f46f09304c79119360f3d</data>
    </node>
    <node id="CUEROS DE LOBOS MARINOS">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">79d9c36d47673af84dba65217ceaddec</data>
      <data key="d3">20</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">409</data>
      <data key="d7">2d336939b0a94ff6a47b8d77af93feee</data>
    </node>
    <node id="LOBOS FAENADOS">
      <data key="d0">MAMMAL</data>
      <data key="d1">Los lobos faenados son mam&#237;feros marinos que son cazados y cuya cantidad debe ser registrada por los concesionarios durante los per&#237;odos reglamentarios de caza.</data>
      <data key="d2">929b52dcc39f3e79e12fe7e15557dbaf</data>
      <data key="d3">43</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">410</data>
      <data key="d7">0e54ff2dc9834b43929dfc72d137cc7b</data>
    </node>
    <node id="PERMISOS">
      <data key="d0">NONE</data>
      <data key="d1">Los "PERMISOS" son autorizaciones esenciales que deben ser obtenidas por individuos o empresas para llevar a cabo actividades de caza e industrializaci&#243;n de elefantes marinos y otros pinn&#237;pedos. Estas autorizaciones son otorgadas por el Ministerio de Agricultura y son espec&#237;ficamente requeridas para la caza de lobos marinos. Adem&#225;s, es fundamental que estos permisos sean mantenidos y controlados por los concesionarios, asegurando as&#237; un manejo adecuado y regulado de las especies marinas involucradas.</data>
      <data key="d2">929b52dcc39f3e79e12fe7e15557dbaf,c189d2e78df197f5464424712ff00b40</data>
      <data key="d3">43</data>
      <data key="d4">1</data>
      <data key="d5">6</data>
      <data key="d6">411</data>
      <data key="d7">96ec6a39cf40466fb6e97b2fb5048ad2</data>
    </node>
    <node id="DIRECCI&#211;N DE GANADER&#205;A">
      <data key="d0">NONE</data>
      <data key="d1">La Direcci&#243;n de Ganader&#237;a es la entidad responsable de supervisar y controlar la caza de lobos marinos y la industrializaci&#243;n de productos derivados de ellos.</data>
      <data key="d2">929b52dcc39f3e79e12fe7e15557dbaf</data>
      <data key="d3">43</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">412</data>
      <data key="d7">e59c18afab0e45d8b95bbb46d8fae42c</data>
    </node>
    <node id="MINISTERIO DE AGRICULTURA">
      <data key="d0">NONE</data>
      <data key="d1">El Ministerio de Agricultura es la autoridad gubernamental encargada de regular y supervisar la explotaci&#243;n de recursos naturales en el pa&#237;s. Entre sus funciones, se incluye la regulaci&#243;n de la caza de lobos marinos y elefantes marinos, otorgando permisos y supervisando dicha actividad. Adem&#225;s, el Ministerio es responsable de la supervisi&#243;n de la explotaci&#243;n de recursos como el guano de aves marinas, asegurando que estas actividades se realicen de manera sostenible y conforme a la normativa vigente.</data>
      <data key="d2">929b52dcc39f3e79e12fe7e15557dbaf,b679eb20179f669b5f28ca4e2550c77d,cd89fd819728e8bb01132a958eb61182</data>
      <data key="d3">43</data>
      <data key="d4">1</data>
      <data key="d5">6</data>
      <data key="d6">413</data>
      <data key="d7">d7105f7f48db47748c9b981a903d581a</data>
    </node>
    <node id="ART&#205;CULOS DE REGULACI&#211;N">
      <data key="d0">NONE</data>
      <data key="d1">Los art&#237;culos de regulaci&#243;n son disposiciones legales que establecen las normas y procedimientos para la caza y faena de lobos marinos y elefantes marinos.</data>
      <data key="d2">929b52dcc39f3e79e12fe7e15557dbaf</data>
      <data key="d3">43</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">414</data>
      <data key="d7">9d4cdf10a0bf4e15bb8acd68838fb569</data>
    </node>
    <node id="ACEITE OBTENIDO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El aceite obtenido es un subproducto de la caza de lobos marinos, utilizado en diversas aplicaciones industriales y comerciales.</data>
      <data key="d2">929b52dcc39f3e79e12fe7e15557dbaf</data>
      <data key="d3">114</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">415</data>
      <data key="d7">cbef1bf2197c469da8e8398e3e207189</data>
    </node>
    <node id="FAENA">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">La faena es el proceso de caza y procesamiento de lobos marinos, que debe realizarse bajo supervisi&#243;n y con permisos adecuados.</data>
      <data key="d2">929b52dcc39f3e79e12fe7e15557dbaf</data>
      <data key="d3">114</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">416</data>
      <data key="d7">e9b4299780d6433ea22d478f48ecf848</data>
    </node>
    <node id="DECRETO N&#176; 56884">
      <data key="d0">NONE</data>
      <data key="d1">El Decreto N&#176; 56884 es una regulaci&#243;n que establece los requisitos para la caza de lobos marinos y la industrializaci&#243;n de pinn&#237;pedos en Argentina.</data>
      <data key="d2">c189d2e78df197f5464424712ff00b40</data>
      <data key="d3">43</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">417</data>
      <data key="d7">7e91960717204dd5a29986f44ad6375a</data>
    </node>
    <node id="ACEITE EXTRA&#205;DO">
      <data key="d0">NONE</data>
      <data key="d1">El aceite extra&#237;do de los pinn&#237;pedos es un subproducto de la caza que debe ser regulado y proviene de concesionarios autorizados.</data>
      <data key="d2">c189d2e78df197f5464424712ff00b40</data>
      <data key="d3">43</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">418</data>
      <data key="d7">051b21e8c23246029ba571fdf3d00a05</data>
    </node>
    <node id="CARACTER&#205;STICAS MORFOL&#211;GICAS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Las caracter&#237;sticas morfol&#243;gicas del ping&#252;ino com&#250;n incluyen aletas transformadas en estructuras para nadar, patas cortas con membranas interdigitales y plumaje blanco y negro.</data>
      <data key="d2">c189d2e78df197f5464424712ff00b40</data>
      <data key="d3">66</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">419</data>
      <data key="d7">3ef86a29ce48453882eff6d41cf34f41</data>
    </node>
    <node id="NATACI&#211;N">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">La nataci&#243;n es el comportamiento principal del ping&#252;ino com&#250;n, facilitado por sus aletas y patas adaptadas, que le permiten moverse con agilidad en el agua.</data>
      <data key="d2">c189d2e78df197f5464424712ff00b40</data>
      <data key="d3">66</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">420</data>
      <data key="d7">10897b124ea94468a147d59732cf6460</data>
    </node>
    <node id="PING&#220;INO COM&#218;N">
      <data key="d0" />
      <data key="d1">El ping&#252;ino com&#250;n (Spheniscus magellanicus) es una especie de ave marina que habita en las costas de Am&#233;rica del Sur. Esta especie es reconocida por su comportamiento social y su tendencia a vivir en colonias. Su presencia en estas &#225;reas costeras es fundamental para el ecosistema marino, ya que interact&#250;a con diversas especies y contribuye a la din&#225;mica de su entorno.</data>
      <data key="d2">8a0c5d2be39b9a9e02f97cbc7551030c,c189d2e78df197f5464424712ff00b40,ff2c7455e99e69b4239b601fef6b447e</data>
      <data key="d3">66</data>
      <data key="d4">1</data>
      <data key="d5">7</data>
      <data key="d6">421</data>
      <data key="d7">f123c08db88843bab97e3c4a9502a5cf</data>
    </node>
    <node id="PING&#220;INO MAGALL&#193;NICO">
      <data key="d0">SPECIES</data>
      <data key="d1">El ping&#252;ino magall&#225;nico (Spheniscus magellanicus) habita las costas del litoral y las islas cercanas de la regi&#243;n, distribuy&#233;ndose principalmente en &#225;reas del litoral patag&#243;nico y de otras islas adyacentes, donde se encuentra en cantidades variables.</data>
      <data key="d2">53e3cb3a2e7aaa1f7ea056e37de6187e</data>
      <data key="d3">62</data>
      <data key="d4">1</data>
      <data key="d5">7</data>
      <data key="d6">422</data>
      <data key="d7">3ca42e8e670f458f876482bf439d28c8</data>
    </node>
    <node id="SPHENISCUS HUMBOLTI">
      <data key="d0">SPECIES</data>
      <data key="d1">Spheniscus Humbolti es otra especie de ping&#252;ino que fue hallada en las inmediaciones del Cabo San Vicente en Tierra del Fuego, conocida por su distribuci&#243;n en &#225;reas costeras.</data>
      <data key="d2">53e3cb3a2e7aaa1f7ea056e37de6187e</data>
      <data key="d3">62</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">423</data>
      <data key="d7">10a1a271d1c64969a89456c6f83f7b0b</data>
    </node>
    <node id="APTENODYTES PATAG&#211;NICA">
      <data key="d0">SPECIES</data>
      <data key="d1">Aptenodytes patag&#243;nica es una especie de ping&#252;ino reconocida por su tama&#241;o y h&#225;bitat en el hemisferio sur, encontrada en la regi&#243;n de Tierra del Fuego.</data>
      <data key="d2">53e3cb3a2e7aaa1f7ea056e37de6187e</data>
      <data key="d3">62</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">424</data>
      <data key="d7">b3aaf860d8884f67a0f13d9986776ab1</data>
    </node>
    <node id="H&#193;BITAT">
      <data key="d0">HABITAT</data>
      <data key="d1">El h&#225;bitat de los ping&#252;inos abarca principalmente zonas costeras donde estos animales forman colonias y construyen nidos para incubar sus huevos. En particular, el h&#225;bitat del ping&#252;ino magall&#225;nico se localiza en las costas del litoral patag&#243;nico y en las islas cercanas, donde se distribuyen en colonias y llevan a cabo su proceso de nidificaci&#243;n. Estas &#225;reas costeras son esenciales para su reproducci&#243;n y supervivencia, proporcionando el entorno adecuado para el desarrollo de sus cr&#237;as.</data>
      <data key="d2">53e3cb3a2e7aaa1f7ea056e37de6187e,c0e82041e872b7b6fe0dc4899137a71d</data>
      <data key="d3">62</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">425</data>
      <data key="d7">2f265085ed33423482bbc5521fc54402</data>
    </node>
    <node id="NIDOS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los nidos de los ping&#252;inos, en particular de los ping&#252;inos comunes y magall&#225;nicos, son estructuras fundamentales para la incubaci&#243;n de sus huevos y la crianza de sus cr&#237;as. Estas construcciones suelen estar ubicadas en &#225;reas protegidas, lo que les proporciona un resguardo esencial contra depredadores y condiciones ambientales adversas. Los nidos se caracterizan por ser huecos subterr&#225;neos, donde los ping&#252;inos muestran un notable cuidado y respeto por su ocupaci&#243;n, asegurando as&#237; la protecci&#243;n y el bienestar de sus pichones durante las etapas cr&#237;ticas de su desarrollo.</data>
      <data key="d2">53e3cb3a2e7aaa1f7ea056e37de6187e,efb532e66a85fbbd396d1e0031bc38c6,ff2c7455e99e69b4239b601fef6b447e</data>
      <data key="d3">63</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">426</data>
      <data key="d7">12e808c8b7874930ba1fdae217320f9b</data>
    </node>
    <node id="FACTOR TEMPERATURA AMBIENTE">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El factor temperatura ambiente influye en la llegada de los ping&#252;inos a sus &#225;reas de distribuci&#243;n, causando variaciones en su arribo durante las temporadas.</data>
      <data key="d2">53e3cb3a2e7aaa1f7ea056e37de6187e</data>
      <data key="d3">62</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">427</data>
      <data key="d7">da08818c7d4e4f5d80ccccfa86c156e5</data>
    </node>
    <node id="PLUMONES">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">53e3cb3a2e7aaa1f7ea056e37de6187e</data>
      <data key="d3">62</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">428</data>
      <data key="d7">1ac8053a5caa4dc3a6ca9a7765eb0afb</data>
    </node>
    <node id="HUEVOS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los "HUEVOS" de los ping&#252;inos comunes son incubados exclusivamente por las hembras, quienes desempe&#241;an un papel fundamental en el cuidado de estos huevos, lo que es crucial para la supervivencia de las cr&#237;as. Estos huevos, que forman parte esencial del ciclo reproductivo de la especie, presentan una c&#225;scara de color blanco-celeste y tienen un tama&#241;o variable, con un peso promedio de 128 gramos. Aunque son comestibles, poseen un fuerte olor y sabor que se asemeja a los narc&#243;ticos.</data>
      <data key="d2">c0e82041e872b7b6fe0dc4899137a71d,efb532e66a85fbbd396d1e0031bc38c6,ff2c7455e99e69b4239b601fef6b447e</data>
      <data key="d3">100</data>
      <data key="d4">2</data>
      <data key="d5">7</data>
      <data key="d6">429</data>
      <data key="d7">f3dbbd8b9dd94d28bc490e03f42172bb</data>
    </node>
    <node id="FECUNDACI&#211;N">
      <data key="d0">REPRODUCTION</data>
      <data key="d1">La fecundaci&#243;n ocurre antes de que las hembras lleguen a los nidos, donde se encuentran huevos, algunos de los cuales son no f&#233;rtiles.</data>
      <data key="d2">efb532e66a85fbbd396d1e0031bc38c6</data>
      <data key="d3">100</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">430</data>
      <data key="d7">b136cddca3804bfd83bd181576364497</data>
    </node>
    <node id="INCUBACI&#211;N ARTIFICIAL">
      <data key="d0">RESEARCH</data>
      <data key="d1">Se intentaron incubaciones artificiales con huevos recogidos, pero ambos intentos fracasaron, con un 40% de los huevos resultando est&#233;riles.</data>
      <data key="d2">efb532e66a85fbbd396d1e0031bc38c6</data>
      <data key="d5">0</data>
      <data key="d6">431</data>
      <data key="d7">63ff911e5a0d4213b2607e88fa6e2059</data>
    </node>
    <node id="MACHO">
      <data key="d0">MAMMAL</data>
      <data key="d1">El macho reemplaza a la hembra en la incubaci&#243;n de los huevos solo cuando ella se aleja del nido para alimentarse.</data>
      <data key="d2">efb532e66a85fbbd396d1e0031bc38c6</data>
      <data key="d3">99</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">432</data>
      <data key="d7">cabce64c3b494a71a803006e2bb02ecd</data>
    </node>
    <node id="PICHONES">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los pichones son alimentados por sus progenitores desde su nacimiento hasta los 45 d&#237;as, y aprenden a moverse en el agua sin ense&#241;anzas expl&#237;citas.</data>
      <data key="d2">efb532e66a85fbbd396d1e0031bc38c6</data>
      <data key="d3">99</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
      <data key="d6">433</data>
      <data key="d7">2271959ef1d546458e95fb69f47710f5</data>
    </node>
    <node id="R&#201;GIMEN ALIMENTICIO">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">La alimentaci&#243;n de los ping&#252;inos magall&#225;nicos se compone principalmente de peque&#241;os peces y mariscos.</data>
      <data key="d2">efb532e66a85fbbd396d1e0031bc38c6</data>
      <data key="d3">99</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">434</data>
      <data key="d7">e7531304f53945e38d1d0918341c8f7f</data>
    </node>
    <node id="PAR&#193;SITOS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los par&#225;sitos observados en estas aves marinas incluyen un piojillo y una tenia, siendo el primero encontrado en casi el 95% de los animales.</data>
      <data key="d2">efb532e66a85fbbd396d1e0031bc38c6</data>
      <data key="d3">99</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">435</data>
      <data key="d7">00715e66bf7b4b3b953043af41650dbb</data>
    </node>
    <node id="CRIANZA">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">La crianza se refiere al proceso en el que los progenitores alimentan y cuidan a los pichones desde su nacimiento hasta que son independientes.</data>
      <data key="d2">efb532e66a85fbbd396d1e0031bc38c6</data>
      <data key="d3">112</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">436</data>
      <data key="d7">b508ae8208944d4c89117656833decfa</data>
    </node>
    <node id="PING&#220;INOS MAGALL&#193;NICOS">
      <data key="d0" />
      <data key="d1">Los ping&#252;inos magall&#225;nicos son aves marinas que habitan en las costas del litoral patag&#243;nico. Se caracterizan por su comportamiento social y su migraci&#243;n estacional, lo que los convierte en una especie emblem&#225;tica de esta regi&#243;n. Su presencia en el ecosistema marino de la Patagonia es fundamental, ya que interact&#250;an con diversas especies y contribuyen a la din&#225;mica del entorno marino.</data>
      <data key="d2">efb532e66a85fbbd396d1e0031bc38c6,f29db5af5c9f3faa40c06d0ba4f0261e</data>
      <data key="d3">112</data>
      <data key="d4">2</data>
      <data key="d5">14</data>
      <data key="d6">437</data>
      <data key="d7">b6409c0acdb946dfa19484605a38c5e5</data>
    </node>
    <node id="TENIA">
      <data key="d0">SPECIES</data>
      <data key="d1">La tenia es un par&#225;sito que puede medir hasta 40 cent&#237;metros de largo y 5 mil&#237;metros de ancho, afectando principalmente a los sujetos adultos de ping&#252;inos magall&#225;nicos.</data>
      <data key="d2">f29db5af5c9f3faa40c06d0ba4f0261e</data>
      <data key="d3">112</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">438</data>
      <data key="d7">85e5f799772246c3af5835cf1027355c</data>
    </node>
    <node id="EMIGRACI&#211;N">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">La emigraci&#243;n de los ping&#252;inos magall&#225;nicos se extiende hasta mediados de marzo, con una notable disminuci&#243;n de colonias en abril.</data>
      <data key="d2">f29db5af5c9f3faa40c06d0ba4f0261e</data>
      <data key="d3">112</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">439</data>
      <data key="d7">8c6c202d1e9c4bacb646475d47cdfac0</data>
    </node>
    <node id="BANCO CORMOR&#193;N">
      <data key="d0">HABITAT</data>
      <data key="d1">El Banco Cormor&#225;n es un sitio costero significativo ubicado en la desembocadura del R&#237;o San Juli&#225;n, conocido por su concentraci&#243;n de grandes cantidades de ping&#252;inos magall&#225;nicos y otras aves marinas. Esta &#225;rea es crucial para la reproducci&#243;n de colonias de ping&#252;inos comunes, lo que la convierte en un h&#225;bitat vital para estas especies. Adem&#225;s, el Banco Cormor&#225;n se encuentra en una formaci&#243;n guanera, lo que indica su importancia ecol&#243;gica y econ&#243;mica, ya que tambi&#233;n es relevante para la actividad de explotaci&#243;n industrial de aves marinas. En conjunto, el Banco Cormor&#225;n representa un ecosistema marino diverso y un punto focal para la conservaci&#243;n y el estudio de las aves marinas en la regi&#243;n.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536,c0e82041e872b7b6fe0dc4899137a71d,f29db5af5c9f3faa40c06d0ba4f0261e,ff2c7455e99e69b4239b601fef6b447e</data>
      <data key="d3">112</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">440</data>
      <data key="d7">195c8881309e46bfbf5bff2b3bbe65c1</data>
    </node>
    <node id="ISLA LEONES">
      <data key="d0">HABITAT</data>
      <data key="d1">La Isla Leones es un importante ecosistema marino ubicado en el extremo sureste de la regi&#243;n, frente a Puerto Santa Cruz. Este lugar es conocido por albergar colonias de ping&#252;inos magall&#225;nicos y ping&#252;inos comunes, lo que lo convierte en un h&#225;bitat seguro para la nidificaci&#243;n y cr&#237;a de estas aves. Adem&#225;s, la isla destaca por la presencia de colonias de cormoranes, que son fundamentales para la producci&#243;n de guano, un recurso valioso en el ecosistema. La combinaci&#243;n de estas caracter&#237;sticas hace de la Isla Leones un sitio de gran relevancia para la conservaci&#243;n de la biodiversidad marina y la investigaci&#243;n cient&#237;fica en la regi&#243;n.</data>
      <data key="d2">f058a062f571d1de67aa67b3be3adee4,f29db5af5c9f3faa40c06d0ba4f0261e,ff2c7455e99e69b4239b601fef6b447e</data>
      <data key="d3">111</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">441</data>
      <data key="d7">64c7a50b3d4d483f8574881d66e110b1</data>
    </node>
    <node id="CONCESIONES">
      <data key="d0">NONE</data>
      <data key="d1">Las "CONCESIONES" son permisos otorgados para la explotaci&#243;n industrial de recursos marinos en &#225;reas costeras espec&#237;ficas. En particular, se refieren a la explotaci&#243;n de ping&#252;inos magall&#225;nicos y del guano de aves marinas. Estas concesiones pueden tener diferentes estados de actividad y limitaciones, lo que sugiere que su uso y regulaci&#243;n est&#225;n sujetos a normativas que buscan equilibrar la explotaci&#243;n econ&#243;mica con la conservaci&#243;n de los ecosistemas marinos.</data>
      <data key="d2">3e11752f9db0c9d6d3511bebdfdf06fa,d385716d4fef57833f794a40e118e214,f29db5af5c9f3faa40c06d0ba4f0261e</data>
      <data key="d3">95</data>
      <data key="d4">2</data>
      <data key="d5">10</data>
      <data key="d6">442</data>
      <data key="d7">fcc7427fc7994795a57773525a7474a8</data>
    </node>
    <node id="&#193;REAS DE DISPERSI&#211;N">
      <data key="d0">HABITAT</data>
      <data key="d1">Las &#225;reas de dispersi&#243;n de los ping&#252;inos magall&#225;nicos son los lugares donde se encuentran en grandes cantidades, abarcando extensiones costeras espec&#237;ficas.</data>
      <data key="d2">f29db5af5c9f3faa40c06d0ba4f0261e</data>
      <data key="d3">112</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">443</data>
      <data key="d7">aaab48150dea4ba188cf5c12ce60efb4</data>
    </node>
    <node id="ISLAS E ISLOTES">
      <data key="d0">HABITAT</data>
      <data key="d1">Las islas e islotes son h&#225;bitats donde se pueden observar ping&#252;inos magall&#225;nicos, aunque no son sitios de procreo.</data>
      <data key="d2">f29db5af5c9f3faa40c06d0ba4f0261e</data>
      <data key="d3">112</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">444</data>
      <data key="d7">10b6c75c9f7e43fb88aae1ec6d8cfc6c</data>
    </node>
    <node id="CAZA">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">La caza de ping&#252;inos implica la extracci&#243;n de su cuero y grasa, utilizando m&#233;todos que pueden resultar en la muerte inmediata del animal.</data>
      <data key="d2">c0e82041e872b7b6fe0dc4899137a71d</data>
      <data key="d3">108</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">445</data>
      <data key="d7">3b801175feca4495a2b56d7f8f774fde</data>
    </node>
    <node id="R&#205;O DESEADO">
      <data key="d0">HABITAT</data>
      <data key="d1">El R&#237;o Deseado es un cuerpo de agua ubicado en la provincia de Santa Cruz, Argentina. Este r&#237;o se destaca por su relaci&#243;n con la ubicaci&#243;n de yacimientos guaneros, que son dep&#243;sitos de guano provenientes de aves marinas. Adem&#225;s, el R&#237;o Deseado es mencionado en el contexto de la concesi&#243;n para la explotaci&#243;n industrial de aves marinas, incluyendo especies como los ping&#252;inos. Tambi&#233;n se encuentra en este r&#237;o el Puerto Yenkys, que juega un papel importante en el proceso de transporte del guano de aves marinas, lo que resalta su relevancia tanto ecol&#243;gica como econ&#243;mica en la regi&#243;n.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536,c0e82041e872b7b6fe0dc4899137a71d,f058a062f571d1de67aa67b3be3adee4</data>
      <data key="d3">50</data>
      <data key="d4">1</data>
      <data key="d5">5</data>
      <data key="d6">446</data>
      <data key="d7">b7b05766cec34acb8c075fb5fa628b1b</data>
    </node>
    <node id="PUERTO S. JULI&#193;N">
      <data key="d0">HABITAT</data>
      <data key="d1">El puerto S. Juli&#225;n es un lugar mencionado en el contexto de la explotaci&#243;n industrial de aves marinas, incluyendo ping&#252;inos.</data>
      <data key="d2">c0e82041e872b7b6fe0dc4899137a71d</data>
      <data key="d3">108</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">447</data>
      <data key="d7">d91858a3de4e4e45a33bea2b0f99d537</data>
    </node>
    <node id="BANCO JUSTICIA">
      <data key="d0">HABITAT</data>
      <data key="d1">El Banco Justicia se localiza al sureste del Banco Cormor&#225;n y tambi&#233;n se caracteriza por ser una formaci&#243;n guanera. Este banco es relevante en el contexto de la concesi&#243;n para la explotaci&#243;n de aves marinas, lo que indica su importancia en la din&#225;mica de la avifauna marina y su posible impacto en el ecosistema local.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536,c0e82041e872b7b6fe0dc4899137a71d</data>
      <data key="d3">108</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">448</data>
      <data key="d7">2d55be222b5f44319601a1e02f2b2b75</data>
    </node>
    <node id="FRANCIA">
      <data key="d0">NONE</data>
      <data key="d1">Francia es mencionada como un mercado potencial para los productos derivados de los ping&#252;inos, aunque actualmente enfrenta restricciones.</data>
      <data key="d2">c0e82041e872b7b6fe0dc4899137a71d</data>
      <data key="d3">67</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">449</data>
      <data key="d7">e39951e7348a4577b0a96ede229d51a8</data>
    </node>
    <node id="ESTADOS UNIDOS">
      <data key="d0">NONE</data>
      <data key="d1">Estados Unidos es mencionado como un posible mercado para los productos de ping&#252;inos, pero tambi&#233;n enfrenta restricciones similares a las de Francia.</data>
      <data key="d2">c0e82041e872b7b6fe0dc4899137a71d</data>
      <data key="d3">113</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">450</data>
      <data key="d7">9f94c819d4b44396b6241e6332f158f6</data>
    </node>
    <node id="DECRETO N.&#186; 12344">
      <data key="d0">NONE</data>
      <data key="d1">El decreto N.&#186; 12344 regula la caza y explotaci&#243;n de los ping&#252;inos, estableciendo normas para la conservaci&#243;n de la especie y la industria relacionada.</data>
      <data key="d2">ff2c7455e99e69b4239b601fef6b447e</data>
      <data key="d3">110</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">451</data>
      <data key="d7">152413b2ed13454ba8296369bbcbf5c0</data>
    </node>
    <node id="CUIDADO DE CR&#205;AS">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">El cuidado de cr&#237;as en los ping&#252;inos comunes implica la protecci&#243;n y alimentaci&#243;n de los j&#243;venes hasta que sean capaces de sobrevivir por s&#237; mismos.</data>
      <data key="d2">ff2c7455e99e69b4239b601fef6b447e</data>
      <data key="d3">111</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">452</data>
      <data key="d7">fd2621c42e054368851eaa0fbd3f6baa</data>
    </node>
    <node id="PERMISOS DE CAZA">
      <data key="d0">NONE</data>
      <data key="d1">Los permisos de caza son autorizaciones otorgadas para la captura de ping&#252;inos, reguladas por el Ministerio de Agricultura para asegurar la conservaci&#243;n de la especie.</data>
      <data key="d2">ff2c7455e99e69b4239b601fef6b447e</data>
      <data key="d3">110</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">453</data>
      <data key="d7">626ca7eab9b24c0097cc8654f4d88523</data>
    </node>
    <node id="PING&#220;INO DE MAGALLANES">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">ff2c7455e99e69b4239b601fef6b447e</data>
      <data key="d3">111</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">454</data>
      <data key="d7">348be33386914ddc92c710c616d74f67</data>
    </node>
    <node id="GUANO DE AVES MARINAS">
      <data key="d0">NONE</data>
      <data key="d1">El guano de aves marinas es un fertilizante natural que se compone de los excrementos de aves guaneras, como los cormoranes, y se encuentra en islas y costas. Este material es altamente valorado en la agricultura y la industria debido a su riqueza en nutrientes, especialmente nitr&#243;geno, &#225;cido fosf&#243;rico y cal. Se utiliza principalmente para enriquecer tierras laborables, siendo especialmente efectivo en cultivos de flores y hortalizas. Adem&#225;s, el guano de aves marinas contribuye a la formaci&#243;n de yacimientos guaneros tanto en &#225;reas continentales como extra-continentales, lo que resalta su importancia ecol&#243;gica y econ&#243;mica en los ecosistemas marinos.</data>
      <data key="d2">144ccee104076cb699414480fca2f46b,3b8a637af69ae3ba996edaf49f1ed1f0,3e11752f9db0c9d6d3511bebdfdf06fa,8a0c5d2be39b9a9e02f97cbc7551030c,f058a062f571d1de67aa67b3be3adee4,fee8446145e958ff9402203e372df57d</data>
      <data key="d3">51</data>
      <data key="d4">1</data>
      <data key="d5">11</data>
      <data key="d6">455</data>
      <data key="d7">827c5b5022aa459687f6d6c302bd2d3a</data>
    </node>
    <node id="AVES GUAN&#205;FERAS">
      <data key="d0">SPECIES</data>
      <data key="d1">Las aves guan&#237;feras son aves que producen guano, conocidas com&#250;nmente como p&#225;jaros guaneros, cormoranes o biguaes, pertenecientes a la familia de los Phalacrocoracideos.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d3">63</data>
      <data key="d4">1</data>
      <data key="d5">6</data>
      <data key="d6">456</data>
      <data key="d7">b7b630ed7f6b4df092d4b0b8dff1b61a</data>
    </node>
    <node id="CORMOR&#193;N DE MAGALLANES">
      <data key="d0">SPECIES</data>
      <data key="d1">El Cormor&#225;n de Magallanes (Phalacrocorax Magellanicus) es una especie de ave guan&#237;fera que se encuentra en las costas de Magallanes, conocida por su comportamiento social y su h&#225;bitat en colonias.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d3">63</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">457</data>
      <data key="d7">a763804bb54e410b96d3e96f9b4f7fc2</data>
    </node>
    <node id="CORMOR&#193;N GRIS">
      <data key="d0">SPECIES</data>
      <data key="d1">El Cormor&#225;n gris (Phalacrocorax gaimardi) es otra especie de ave guan&#237;fera que habita en la regi&#243;n, caracterizada por su plumaje y su comportamiento en colonias.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d3">63</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">458</data>
      <data key="d7">34300b899c604a088dd64b1f43943374</data>
    </node>
    <node id="CORMOR&#193;N">
      <data key="d0">SPECIES</data>
      <data key="d1">El Cormor&#225;n (Phalacrocorax Albiventer) es una especie de ave guan&#237;fera que se encuentra en la regi&#243;n, conocida por su capacidad de adaptaci&#243;n a diferentes h&#225;bitats marinos.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d3">63</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">459</data>
      <data key="d7">afa2d01cd0cd471b82edabcf9e763550</data>
    </node>
    <node id="SUELOS GUANEROS">
      <data key="d0">HABITAT</data>
      <data key="d1">Los suelos guaneros son aquellos donde se depositan los excrementos de las aves guaneras, y su naturaleza influye en la explotaci&#243;n industrial del guano.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d5">1</data>
      <data key="d6">460</data>
      <data key="d7">461ec092db6c42c993e3e3e25d9c31fa</data>
    </node>
    <node id="YACIMIENTOS EXTRA-CONTINENTALES">
      <data key="d0">HABITAT</data>
      <data key="d1">Los yacimientos extra-continentales son dep&#243;sitos de guano que se encuentran en islas, que a menudo son dif&#237;ciles de explotar debido a su ubicaci&#243;n y acceso.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d5">1</data>
      <data key="d6">461</data>
      <data key="d7">1350aa5530634f1b8641859ba9e66698</data>
    </node>
    <node id="COMPORTAMIENTO">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">El comportamiento de las aves guaneras incluye actitudes de reposo y la b&#250;squeda de alimentos, que consisten en peque&#241;os peces y mariscos.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d3">63</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">462</data>
      <data key="d7">e2f44674028b48709c98a85732e3c746</data>
    </node>
    <node id="ISLAS BLANCAS">
      <data key="d0">HABITAT</data>
      <data key="d1">Las Islas Blancas son un grupo de islas situadas al noreste del Puerto Camarones, en la Bah&#237;a Camarones. Este archipi&#233;lago es notable por la presencia de yacimientos de guano de aves marinas, lo que ha llevado a la concesi&#243;n de la explotaci&#243;n de recursos en la zona. La combinaci&#243;n de su ubicaci&#243;n estrat&#233;gica y la riqueza de sus recursos naturales las convierte en un &#225;rea de inter&#233;s tanto ecol&#243;gico como econ&#243;mico.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536,d385716d4fef57833f794a40e118e214</data>
      <data key="d3">47</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">463</data>
      <data key="d7">5791c66ab0214ec09f74eb16b431a382</data>
    </node>
    <node id="ISLA MAYOR DE LAS VERNACI">
      <data key="d0">HABITAT</data>
      <data key="d1">La Isla Mayor de las Vernaci es un lugar donde se encuentran yacimientos de guano, con dificultades para el embarque del producto.</data>
      <data key="d2">d385716d4fef57833f794a40e118e214</data>
      <data key="d3">103</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">464</data>
      <data key="d7">62afed864a914a3f8c5ddd4f7204e61d</data>
    </node>
    <node id="ISLA BLANCA">
      <data key="d0">HABITAT</data>
      <data key="d1">Isla Blanca es un h&#225;bitat significativo que alberga diversas colonias de aves marinas, incluyendo ping&#252;inos, y lobos marinos, lo que contribuye a la diversidad de la fauna en la regi&#243;n. Este ecosistema se localiza al sur de la desembocadura del R&#237;o Deseado y es conocido por la presencia de yacimientos guaneros, aunque su explotaci&#243;n es objeto de cuestionamientos debido a la profundidad de estos dep&#243;sitos. La combinaci&#243;n de estas caracter&#237;sticas hace de Isla Blanca un lugar de gran importancia ecol&#243;gica y biodiversidad en su entorno marino.</data>
      <data key="d2">2d041f866c2a7f149216961d43696c82,5a07380f5aada9c6c6ef41f242e1c536,abfbf0cbd4646b7d6aff58787b3de0bd,d385716d4fef57833f794a40e118e214</data>
      <data key="d3">106</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
      <data key="d6">465</data>
      <data key="d7">c43b6a25621a461ea0b25f2c9602e491</data>
    </node>
    <node id="PUERTO CAMARONES">
      <data key="d0">HABITAT</data>
      <data key="d1">Puerto Camarones es una localidad cercana a las Islas Blancas, donde se realizan actividades relacionadas con la explotaci&#243;n de guano.</data>
      <data key="d2">d385716d4fef57833f794a40e118e214</data>
      <data key="d3">47</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">466</data>
      <data key="d7">65dd1070270340cc97cc25ea434e8911</data>
    </node>
    <node id="PUERTO DESEADO">
      <data key="d0">HABITAT</data>
      <data key="d1">Puerto Deseado es una zona donde se localizan yacimientos guaneros, espec&#237;ficamente en la Isla Blanca, que presentan desaf&#237;os para su explotaci&#243;n.</data>
      <data key="d2">d385716d4fef57833f794a40e118e214</data>
      <data key="d3">106</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">467</data>
      <data key="d7">a48d5e528d3f4659be97f26a52a3b178</data>
    </node>
    <node id="EIRAS, ADOLFO">
      <data key="d0">RESEARCH</data>
      <data key="d1">Adolfo Eiras es un concesionario que explota guano en Cabo Guardi&#225;n, al norte de Bah&#237;a Laura, Santa Cruz.</data>
      <data key="d2">d385716d4fef57833f794a40e118e214</data>
      <data key="d3">95</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">468</data>
      <data key="d7">094ecd25f16c444a82c740dff8a86336</data>
    </node>
    <node id="MART&#205;NEZ, AGUST&#205;N">
      <data key="d0">RESEARCH</data>
      <data key="d1">Agust&#237;n Mart&#237;nez es un concesionario que explota guano en las Islas Chata y Ping&#252;ino, en Santa Cruz.</data>
      <data key="d2">d385716d4fef57833f794a40e118e214</data>
      <data key="d3">95</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">469</data>
      <data key="d7">ffc5b2d4f3aa4a94a75c10a6e2702a59</data>
    </node>
    <node id="VERDEAL HERMANOS">
      <data key="d0">RESEARCH</data>
      <data key="d1">Verdeal Hermanos es un concesionario que explota guano en las Islas Viana, en Bah&#237;a Bustamante, Chubut.</data>
      <data key="d2">d385716d4fef57833f794a40e118e214</data>
      <data key="d3">95</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">470</data>
      <data key="d7">ca2b7dbe344b4e898a9a82f4a3618e8b</data>
    </node>
    <node id="VILLAR, M. ISIDRO">
      <data key="d0">RESEARCH</data>
      <data key="d1">M. Isidro Villar es un concesionario que explota guano en las Islas Blanca, Vernaci y Punta Tombo, en Chubut.</data>
      <data key="d2">d385716d4fef57833f794a40e118e214</data>
      <data key="d3">95</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">471</data>
      <data key="d7">64acdfc52e7145bfa574ad5a63867dd3</data>
    </node>
    <node id="EMBARQUE">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">El embarque es la actividad de transportar el guano recolectado desde las islas hasta los mercados, que enfrenta dificultades log&#237;sticas.</data>
      <data key="d2">d385716d4fef57833f794a40e118e214</data>
      <data key="d3">103</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">472</data>
      <data key="d7">2404cb3dbb0b448db4a49402f9d7ef1a</data>
    </node>
    <node id="BOLSAS DE GUANO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Las bolsas de guano son contenedores utilizados para almacenar y transportar el guano, generalmente de segundo y tercer uso, con una capacidad promedio de 60 kilogramos.</data>
      <data key="d2">d385716d4fef57833f794a40e118e214</data>
      <data key="d3">103</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">473</data>
      <data key="d7">c324ead5f5af40738c9b00f4c118baa2</data>
    </node>
    <node id="CANTONES">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">Los cantones son veh&#237;culos utilizados para transportar las bolsas de guano desde los lugares de extracci&#243;n hasta los sitios de embarque.</data>
      <data key="d2">d385716d4fef57833f794a40e118e214</data>
      <data key="d3">103</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">474</data>
      <data key="d7">2e2b1583813042a59b2c080be13e1d86</data>
    </node>
    <node id="EXTRACCI&#211;N DE GUANO">
      <data key="d0" />
      <data key="d1">La extracci&#243;n de guano es el proceso de recolectar excrementos de aves marinas, que se utiliza principalmente como fertilizante debido a su alto contenido en nutrientes. Este proceso no solo tiene aplicaciones comerciales en la agricultura, sino que tambi&#233;n puede influir en la salud de los ecosistemas marinos, ya que la recolecci&#243;n de guano puede afectar las poblaciones de aves y la biodiversidad en las &#225;reas donde se lleva a cabo.</data>
      <data key="d2">b679eb20179f669b5f28ca4e2550c77d,d385716d4fef57833f794a40e118e214</data>
      <data key="d3">49</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">475</data>
      <data key="d7">b380396a5bdd4361a0bf29d86435bb65</data>
    </node>
    <node id="NITR&#211;GENO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El nitr&#243;geno es un elemento qu&#237;mico esencial que se encuentra en el guano de aves marinas, representando entre el 6 y el 8% de su composici&#243;n.</data>
      <data key="d2">f058a062f571d1de67aa67b3be3adee4</data>
      <data key="d3">51</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">476</data>
      <data key="d7">f84d76d399964915b5a470b4a4841fd4</data>
    </node>
    <node id="&#193;CIDO FOSF&#211;RICO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El &#225;cido fosf&#243;rico es un componente del guano de aves marinas, constituyendo el 17% de su composici&#243;n, y es crucial para el crecimiento de las plantas.</data>
      <data key="d2">f058a062f571d1de67aa67b3be3adee4</data>
      <data key="d3">51</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">477</data>
      <data key="d7">463da01eec844bcda52ad62f045ab488</data>
    </node>
    <node id="CAL">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">La cal es otro componente del guano de aves marinas, tambi&#233;n representando el 17% de su composici&#243;n, y se utiliza para mejorar la calidad del suelo.</data>
      <data key="d2">f058a062f571d1de67aa67b3be3adee4</data>
      <data key="d3">51</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">478</data>
      <data key="d7">d619cc2728764c9c9a8ec92bdd628154</data>
    </node>
    <node id="POTASIO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El potasio es un elemento que se encuentra en el guano de aves marinas en cantidades bajas, alrededor del 1%, y es importante para el desarrollo de las plantas.</data>
      <data key="d2">f058a062f571d1de67aa67b3be3adee4</data>
      <data key="d3">51</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">479</data>
      <data key="d7">96608a127c3749f890920a189314646d</data>
    </node>
    <node id="ISLA MONTE LE&#211;N">
      <data key="d0">HABITAT</data>
      <data key="d1">La Isla Monte Le&#243;n es un lugar situado al sur del Puerto Santa Cruz, conocido por albergar una numerosa colonia de cormoranes que habitan permanentemente en la isla. En el pasado, esta isla fue explotada por su guano, un recurso valioso en la agricultura. Actualmente, se encuentra al sur de la Punta Entrada y presenta sedimento guanero en v&#237;as de formaci&#243;n, lo que sugiere un proceso continuo de acumulaci&#243;n de este material org&#225;nico. La combinaci&#243;n de su biodiversidad aviar y su historia de explotaci&#243;n resalta la importancia ecol&#243;gica y econ&#243;mica de la Isla Monte Le&#243;n en el contexto marino de la regi&#243;n.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536,f058a062f571d1de67aa67b3be3adee4</data>
      <data key="d3">107</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">480</data>
      <data key="d7">faec18f448bc4850963a900aae4c358c</data>
    </node>
    <node id="CORMORANES MAGALL&#193;NICOS">
      <data key="d0">SPECIES</data>
      <data key="d1">Los cormoranes magall&#225;nicos (Phalacrocorax magellanicus) son aves marinas que nidifican en colonias en las costas de la Patagonia, siendo un componente importante del ecosistema marino.</data>
      <data key="d2">f058a062f571d1de67aa67b3be3adee4</data>
      <data key="d3">107</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">481</data>
      <data key="d7">f394dbdf33764d65bcec7d77124e4127</data>
    </node>
    <node id="MOLIENDA A MARTILLO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">La molienda a martillo es el sistema empleado para procesar el guano de aves marinas, transform&#225;ndolo en un polvo relativamente fino para su uso.</data>
      <data key="d2">f058a062f571d1de67aa67b3be3adee4</data>
      <data key="d3">51</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">482</data>
      <data key="d7">0821c67a0b754e86bba6e928ce4f1eff</data>
    </node>
    <node id="YACIMIENTO">
      <data key="d0">HABITAT</data>
      <data key="d1">El yacimiento de guano de aves marinas es el lugar donde se extrae este fertilizante natural, y se encuentra en plena actividad, aunque est&#225; en riesgo de agotamiento.</data>
      <data key="d2">f058a062f571d1de67aa67b3be3adee4</data>
      <data key="d3">51</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">483</data>
      <data key="d7">5a9f43864f7447c6873c2f07d5fde600</data>
    </node>
    <node id="PUERTO YENKYS">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">f058a062f571d1de67aa67b3be3adee4</data>
      <data key="d3">50</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">484</data>
      <data key="d7">0902df2c12ea4ad092f994f6d69fbebe</data>
    </node>
    <node id="BAH&#205;A LAURA">
      <data key="d0">HABITAT</data>
      <data key="d1">Bah&#237;a Laura es una ubicaci&#243;n costera situada en el sur de Puerto Deseado, en la Gobernaci&#243;n de Santa Cruz. En esta &#225;rea, se han realizado observaciones significativas sobre la explotaci&#243;n de recursos marinos, espec&#237;ficamente en relaci&#243;n con la extracci&#243;n de guano de aves marinas. Estas actividades reflejan la importancia de Bah&#237;a Laura como un punto de inter&#233;s para el estudio de los ecosistemas marinos y la gesti&#243;n sostenible de los recursos naturales en la regi&#243;n.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536,fee8446145e958ff9402203e372df57d</data>
      <data key="d3">50</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">485</data>
      <data key="d7">9aa8372891b740e0af0e71262e8f673e</data>
    </node>
    <node id="PUNTA TOMBO">
      <data key="d0">HABITAT</data>
      <data key="d1">Punta Tombo es un h&#225;bitat destacado por ser una colonia significativa de ping&#252;inos comunes de Magallanes, lo que la convierte en un sitio de gran importancia para la conservaci&#243;n de esta especie. Adem&#225;s, Punta Tombo se ubica en una zona costera al norte de Bah&#237;a Janssen, caracterizada por la presencia de m&#233;danos arenosos m&#243;viles, lo que contribuye a la diversidad de su ecosistema. Esta combinaci&#243;n de caracter&#237;sticas hace de Punta Tombo un lugar crucial tanto para la fauna marina como para el estudio de las interacciones ecol&#243;gicas en su entorno.</data>
      <data key="d2">2d041f866c2a7f149216961d43696c82,5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">52</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">486</data>
      <data key="d7">85441af9367d4372b6da00e4508b9c98</data>
    </node>
    <node id="CABO GUARDI&#193;N">
      <data key="d0">HABITAT</data>
      <data key="d1">Cabo Guardi&#225;n es un islote rocoso ubicado en el noreste, caracterizado por su suelo rocoso y sedimento en explotaci&#243;n activa. Este h&#225;bitat costero es notable por albergar ping&#252;inos comunes de Magallanes y diversas aves marinas, lo que lo convierte en un ecosistema importante para la biodiversidad marina. La presencia de estas especies av&#237;colas indica un entorno saludable y funcional, donde las interacciones entre las aves y su h&#225;bitat contribuyen a la din&#225;mica ecol&#243;gica de la regi&#243;n.</data>
      <data key="d2">2d041f866c2a7f149216961d43696c82,5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">47</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">487</data>
      <data key="d7">3d09274b35424d6c970dc27317ae4118</data>
    </node>
    <node id="ISLOTES AGUIL&#211;N NORTE Y SUR">
      <data key="d0">HABITAT</data>
      <data key="d1">Los islotes Aguil&#243;n Norte y Sur son rocosos y se encuentran al norte del Golfo de San Jorge, con sedimento en el primero.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">47</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">488</data>
      <data key="d7">e6f7011257cf4af7a1a9343a5e5c488f</data>
    </node>
    <node id="ISLOTE MORENO">
      <data key="d0">HABITAT</data>
      <data key="d1">El Islote Moreno se encuentra al sur de Bah&#237;a Camarones, en el contexto de la explotaci&#243;n de recursos guaneros.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d5">0</data>
      <data key="d6">489</data>
      <data key="d7">6b48da56ae214e158f1290efa1734851</data>
    </node>
    <node id="ISLAS VIVANA">
      <data key="d0">HABITAT</data>
      <data key="d1">Las Islas Viana son un grupo de islas rocosas al norte, donde se ha concedido la explotaci&#243;n de recursos.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d5">0</data>
      <data key="d6">490</data>
      <data key="d7">32c3e25520fb4029aaa803a020a73548</data>
    </node>
    <node id="ISLAS ISABEL">
      <data key="d0">HABITAT</data>
      <data key="d1">Las Islas Isabel son tres islas en la costa de Bah&#237;a Bustamante, donde se ha encontrado guano.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">107</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">491</data>
      <data key="d7">23c9f5f9ac80435ab17f9139d3a69843</data>
    </node>
    <node id="ISLAS VERNACI">
      <data key="d0">HABITAT</data>
      <data key="d1">Las Islas Vernaci son un grupo de islas ubicadas en la caleta Malaspina, reconocidas por sus abundantes reservas de guano. Este archipi&#233;lago no solo es importante por su producci&#243;n de guano, sino que tambi&#233;n sirve como un h&#225;bitat crucial para diversas especies de aves marinas, donde se pueden observar tanto a las aves como a sus nidos. La presencia de estas aves y su interacci&#243;n con el entorno subrayan la importancia ecol&#243;gica de las Islas Vernaci en el contexto de los ecosistemas marinos.</data>
      <data key="d2">2d041f866c2a7f149216961d43696c82,5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">105</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">492</data>
      <data key="d7">3c0b3705ae454a26b1fb1e225588eefd</data>
    </node>
    <node id="ISLA GUANO">
      <data key="d0">HABITAT</data>
      <data key="d1">La Isla Guano est&#225; cerca del Arrecife Burgos, mencionada por su cantidad de guano.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">55</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">493</data>
      <data key="d7">9950139c970e4d5ea8aa44b698bc93bf</data>
    </node>
    <node id="ISLA SHAG">
      <data key="d0">HABITAT</data>
      <data key="d1">La Isla Shag es una isla rocosa con bastante cantidad de guano.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d5">0</data>
      <data key="d6">494</data>
      <data key="d7">1817662a38554d108063f0a5912668d3</data>
    </node>
    <node id="ISLA RASA CHICA">
      <data key="d0">HABITAT</data>
      <data key="d1">La Isla Rasa Chica se encuentra al este de Cabo Guardi&#225;n, mencionada por su cantidad de guano.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d5">0</data>
      <data key="d6">495</data>
      <data key="d7">b3151c2b8f304e59bfbb0e8e7b12793e</data>
    </node>
    <node id="ISLAS LEONES">
      <data key="d0">HABITAT</data>
      <data key="d1">Las Islas Leones son dos islas en la desembocadura del R&#237;o Santa Cruz, mencionadas por su formaci&#243;n guanera.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">107</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">496</data>
      <data key="d7">d2ff298552a84e4b93dd02873b7326da</data>
    </node>
    <node id="ISLOTE SAN JUAN">
      <data key="d0">HABITAT</data>
      <data key="d1">El Islote San Juan est&#225; al norte del Cabo hom&#243;nimo, mencionado por su cantidad de guano.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d5">0</data>
      <data key="d6">497</data>
      <data key="d7">87e2300ace774f6bb8d7a62f18c6f135</data>
    </node>
    <node id="DISPOSICIONES Y REGLAMENTOS">
      <data key="d0">NONE</data>
      <data key="d1">Las disposiciones y reglamentos para la explotaci&#243;n de guano de aves marinas est&#225;n regulados por el Decreto N&#176; 128730.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">104</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">498</data>
      <data key="d7">6ef808611c5a4768b84df1e658fb9a61</data>
    </node>
    <node id="ZONA SUR DEL R&#205;O DESEADO">
      <data key="d0">HABITAT</data>
      <data key="d1">La zona sur del R&#237;o Deseado es un &#225;rea geogr&#225;fica en Santa Cruz, relevante para la explotaci&#243;n de recursos guaneros.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">50</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">499</data>
      <data key="d7">de571c9bd88d4019b236c1aa4c542c97</data>
    </node>
    <node id="ZONA CONCEDIDA">
      <data key="d0">NONE</data>
      <data key="d1">La zona concedida se refiere a &#225;reas espec&#237;ficas donde se ha permitido la explotaci&#243;n de recursos guaneros.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">104</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">500</data>
      <data key="d7">ca14e916261b4bc591dc8f9367c07d20</data>
    </node>
    <node id="SEDIMENTO EN EXPLOTACI&#211;N">
      <data key="d0">MARINE ECOSYSTEM</data>
      <data key="d1">El sedimento en explotaci&#243;n se refiere a los dep&#243;sitos de guano que est&#225;n siendo utilizados industrialmente.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">47</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">501</data>
      <data key="d7">bf4fd1728cb04118bad643d0e083cf4e</data>
    </node>
    <node id="SUELO ROCOSO">
      <data key="d0">HABITAT</data>
      <data key="d1">El suelo rocoso es una caracter&#237;stica del Cabo Guardi&#225;n, que afecta la explotaci&#243;n de recursos guaneros.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">47</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">502</data>
      <data key="d7">749604ebf26448669886f54093f0afb8</data>
    </node>
    <node id="ABUNDANCIA DE M&#201;DANOS ARENOSOS">
      <data key="d0">HABITAT</data>
      <data key="d1">La abundancia de m&#233;danos arenosos m&#243;viles en Punta Tombo impide la explotaci&#243;n efectiva de recursos guaneros.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">52</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">503</data>
      <data key="d7">d480385064194a1eb6fc82762b909ee4</data>
    </node>
    <node id="RECURSOS GUANEROS">
      <data key="d0">MARINE ECOSYSTEM</data>
      <data key="d1">Los recursos guaneros son dep&#243;sitos de guano que se encuentran en diversas islas y costas, importantes para la industria.</data>
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">104</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">504</data>
      <data key="d7">68b1d1f9a2e341bbab7a975d2d1cb2d8</data>
    </node>
    <node id="DECRETO N&#176; 128730">
      <data key="d0">NONE</data>
      <data key="d1">El Decreto N&#176; 128730 es una normativa que regula la explotaci&#243;n de guano de aves marinas en Argentina. Esta regulaci&#243;n establece condiciones y procedimientos espec&#237;ficos para la extracci&#243;n de guano, as&#237; como para las actividades industriales relacionadas con su producci&#243;n y uso. Adem&#225;s, el decreto se enfoca en la gesti&#243;n de los yacimientos de guano de aves marinas en la regi&#243;n, asegurando que las pr&#225;cticas de explotaci&#243;n se realicen de manera sostenible y responsable.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d,5a07380f5aada9c6c6ef41f242e1c536,b679eb20179f669b5f28ca4e2550c77d</data>
      <data key="d3">44</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">505</data>
      <data key="d7">f8a95b7f8921434abae7cc663710a7c0</data>
    </node>
    <node id="GALP&#211;N TIPO &quot;HANGAR&quot;">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">5a07380f5aada9c6c6ef41f242e1c536</data>
      <data key="d3">50</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">506</data>
      <data key="d7">7f6a3102888d43509fe8387236033024</data>
    </node>
    <node id="PERMISIONARIOS">
      <data key="d0">NONE</data>
      <data key="d1">Los permisionarios son individuos o entidades que han obtenido la autorizaci&#243;n del gobierno, espec&#237;ficamente del Ministerio de Agricultura, para realizar actividades de explotaci&#243;n de recursos naturales. En este contexto, su principal actividad es la extracci&#243;n de guano, un recurso proveniente de las aves marinas, que se lleva a cabo en &#225;reas espec&#237;ficas designadas para tal fin. Esta autorizaci&#243;n permite a los permisionarios operar legalmente en la recolecci&#243;n de guano, contribuyendo as&#237; a la econom&#237;a local y a la gesti&#243;n sostenible de los recursos marinos.</data>
      <data key="d2">b679eb20179f669b5f28ca4e2550c77d,cd89fd819728e8bb01132a958eb61182</data>
      <data key="d3">49</data>
      <data key="d4">1</data>
      <data key="d5">8</data>
      <data key="d6">507</data>
      <data key="d7">828edc8af51f4a8f9187ac0df5ae1870</data>
    </node>
    <node id="YACIMIENTOS DE GUANO">
      <data key="d0">NONE</data>
      <data key="d1">Los yacimientos de guano son &#225;reas donde se acumulan excrementos de aves marinas, que pueden ser explotados comercialmente.</data>
      <data key="d2">b679eb20179f669b5f28ca4e2550c77d</data>
      <data key="d5">1</data>
      <data key="d6">508</data>
      <data key="d7">0da7b2df993e4ae4b95fdf26b1fd7dbe</data>
    </node>
    <node id="DERECHO DE INSPECCI&#211;N">
      <data key="d0">NONE</data>
      <data key="d1">El derecho de inspecci&#243;n es un costo que deben pagar los permisionarios por cada tonelada de guano extra&#237;do, destinado a la supervisi&#243;n de la actividad.</data>
      <data key="d2">b679eb20179f669b5f28ca4e2550c77d</data>
      <data key="d3">103</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">509</data>
      <data key="d7">dafded96ace342958d79bc40e59029bf</data>
    </node>
    <node id="TR&#193;FICO DE CONCESIONES">
      <data key="d0">NONE</data>
      <data key="d1">El tr&#225;fico de concesiones se refiere a la pr&#225;ctica de solicitar y obtener permisos para la explotaci&#243;n de recursos, a menudo con fines no leg&#237;timos.</data>
      <data key="d2">b679eb20179f669b5f28ca4e2550c77d</data>
      <data key="d3">44</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">510</data>
      <data key="d7">05c0d89368e6408f93431b224be4f62b</data>
    </node>
    <node id="GARANT&#205;AS">
      <data key="d0">NONE</data>
      <data key="d1">Las garant&#237;as son medidas de seguridad requeridas para asegurar el cumplimiento de las obligaciones por parte de los permisionarios en la explotaci&#243;n de guano.</data>
      <data key="d2">b679eb20179f669b5f28ca4e2550c77d</data>
      <data key="d3">49</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">511</data>
      <data key="d7">00b83212a2fa41938deebb2343d6d5b5</data>
    </node>
    <node id="PLANO DE UBICACI&#211;N">
      <data key="d0">NONE</data>
      <data key="d1">El plano de ubicaci&#243;n es un documento que debe acompa&#241;ar la solicitud de explotaci&#243;n, indicando la extensi&#243;n y localizaci&#243;n de los yacimientos de guano.</data>
      <data key="d2">b679eb20179f669b5f28ca4e2550c77d</data>
      <data key="d3">49</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">512</data>
      <data key="d7">316660d0dc6c47bab779f2c03811bf1a</data>
    </node>
    <node id="COSTAS DEL LITORAL ATL&#193;NTICO">
      <data key="d0">HABITAT</data>
      <data key="d1">Las costas del litoral atl&#225;ntico son el h&#225;bitat donde se concentran las colonias de lobos marinos de un pelo y otras especies de pinn&#237;pedos.</data>
      <data key="d2">cd89fd819728e8bb01132a958eb61182</data>
      <data key="d3">66</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">513</data>
      <data key="d7">603b24ef4b8b473cb957b1fb9e49a577</data>
    </node>
    <node id="EMBARCACIONES">
      <data key="d0">NONE</data>
      <data key="d1">Las embarcaciones son veh&#237;culos utilizados para el transporte de mercanc&#237;as, en este caso, guano, desde los lugares de explotaci&#243;n hacia puertos habilitados.</data>
      <data key="d2">cd89fd819728e8bb01132a958eb61182</data>
      <data key="d3">103</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">514</data>
      <data key="d7">910fa6fea3e4431aa0cccd5accc5aacd</data>
    </node>
    <node id="AUTORIDAD JUDICIAL">
      <data key="d0">NONE</data>
      <data key="d1">La autoridad judicial es el organismo encargado de supervisar y validar las actividades relacionadas con la extracci&#243;n de guano y el cumplimiento de las normativas.</data>
      <data key="d2">cd89fd819728e8bb01132a958eb61182</data>
      <data key="d3">49</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">515</data>
      <data key="d7">417fc80344214be0b2206ac1a621ca88</data>
    </node>
    <node id="NACIONALIDAD">
      <data key="d0">NONE</data>
      <data key="d1">La nacionalidad se refiere a la identificaci&#243;n legal de los permisionarios y su personal, necesaria para la regulaci&#243;n de la explotaci&#243;n de recursos.</data>
      <data key="d2">cd89fd819728e8bb01132a958eb61182</data>
      <data key="d3">49</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">516</data>
      <data key="d7">d130175103bd44729ce297d2ff4fc70c</data>
    </node>
    <node id="DOCUMENTOS DE IDENTIDAD">
      <data key="d0">NONE</data>
      <data key="d1">Los documentos de identidad son registros oficiales que validan la identidad de los permisionarios y su personal en el contexto de la explotaci&#243;n de guano.</data>
      <data key="d2">cd89fd819728e8bb01132a958eb61182</data>
      <data key="d3">49</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">517</data>
      <data key="d7">aa800d89385141bfa0c9addba00dd60b</data>
    </node>
    <node id="PROCREO DE LAS AVES">
      <data key="d0">REPRODUCTION</data>
      <data key="d1">El procreo de las aves es el per&#237;odo en el que las aves se reproducen, lo que afecta la extracci&#243;n de guano en los lugares de explotaci&#243;n.</data>
      <data key="d2">cd89fd819728e8bb01132a958eb61182</data>
      <data key="d3">103</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">518</data>
      <data key="d7">94e938da4c0e4095b8015f2fcc8a5a61</data>
    </node>
    <node id="ORCAS">
      <data key="d0">SPECIES</data>
      <data key="d1">Las orcas (Orsinus orca Magall&#225;nica) son los enemigos naturales de los lobos marinos, representando una amenaza significativa para su poblaci&#243;n.</data>
      <data key="d2">144ccee104076cb699414480fca2f46b</data>
      <data key="d3">26</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">519</data>
      <data key="d7">69aad191957e4cdc84874b7c7900e09a</data>
    </node>
    <node id="PING&#220;INO COM&#218;N DE MAGALLANES">
      <data key="d0">SPECIES</data>
      <data key="d1">El ping&#252;ino com&#250;n de Magallanes (Spheniscus magellanicus) es un ave anfibia y marina que habita en la costa atl&#225;ntica y en islas adyacentes, especialmente en las costas argentinas. Se estima que su poblaci&#243;n oscila entre 320,000 y 350,000 individuos, lo que indica una presencia significativa en la regi&#243;n. Este ping&#252;ino forma colonias en estas &#225;reas costeras, lo que resalta su importancia ecol&#243;gica y social en el ecosistema marino de la zona.</data>
      <data key="d2">144ccee104076cb699414480fca2f46b,2d041f866c2a7f149216961d43696c82</data>
      <data key="d3">105</data>
      <data key="d4">2</data>
      <data key="d5">7</data>
      <data key="d6">520</data>
      <data key="d7">5bbd8bdb79c642cc98730f15f376f667</data>
    </node>
    <node id="CORMOR&#193;N COM&#218;N DE MAGALLANES">
      <data key="d0">SPECIES</data>
      <data key="d1">El cormor&#225;n com&#250;n de Magallanes (Phalacrocorax magellanicus) es la especie que m&#225;s contribuye a la formaci&#243;n de guano en la regi&#243;n.</data>
      <data key="d2">144ccee104076cb699414480fca2f46b</data>
      <data key="d3">51</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">521</data>
      <data key="d7">24db90ae4f594fb7826fce9918f8a32f</data>
    </node>
    <node id="LACANTOS">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">Los lacantos son el periodo cr&#237;tico en la vida de los lobatos, que ocurre durante su lactancia.</data>
      <data key="d2">144ccee104076cb699414480fca2f46b</data>
      <data key="d3">73</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">522</data>
      <data key="d7">aff2cacb1d1a4f04bc900ed3ad7fc09e</data>
    </node>
    <node id="MAGALLANES">
      <data key="d0">NONE</data>
      <data key="d1">Magallanes es una regi&#243;n geogr&#225;fica que alberga diversas especies de aves marinas, incluyendo cormoranes y lobos marinos.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d5">0</data>
      <data key="d6">523</data>
      <data key="d7">528a3e762282405c97d1606c827c909c</data>
    </node>
    <node id="BIGU&#193;">
      <data key="d0">SPECIES</data>
      <data key="d1">El bigu&#225;, o cormor&#225;n gris, es una especie de ave marina que habita en las costas de Am&#233;rica del Sur, caracterizada por su plumaje oscuro y habilidades de buceo.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d3">64</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">524</data>
      <data key="d7">cfda03cfa18f47d7a565b66626c5ed1b</data>
    </node>
    <node id="RECI&#201;N NACIDO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El reci&#233;n nacido de lobo marino de un pelo es amamantado por su madre hasta los seis meses y comienza su vida en el medio acu&#225;tico a los tres meses.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d3">38</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">525</data>
      <data key="d7">56b3e09af4444f17a81389968959e7db</data>
    </node>
    <node id="LOBESNOS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los lobeznos son los j&#243;venes lobos marinos reci&#233;n nacidos, que presentan variaciones en tama&#241;o y peso durante sus primeros d&#237;as de vida.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d3">38</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">526</data>
      <data key="d7">b4666444d7c94c91a6e1fd23108d46ad</data>
    </node>
    <node id="MIRUNGA LEONINA">
      <data key="d0">SPECIES</data>
      <data key="d1">Mirounga leonina es una especie de elefante marino que se caracteriza por su gran tama&#241;o y su h&#225;bitat en aguas fr&#237;as del hemisferio sur.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d3">68</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">527</data>
      <data key="d7">bf3a9fcaab40431d8197a5d7ad969a95</data>
    </node>
    <node id="PARADEROS">
      <data key="d0">NONE</data>
      <data key="d1">Los paraderos son lugares donde se agrupan los lobos marinos, tanto en costas continentales como extra-continentales, para descansar y reproducirse.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d5">0</data>
      <data key="d6">528</data>
      <data key="d7">2a4a8ee10e37438f9379a359fbe842ce</data>
    </node>
    <node id="COMPONENTES QU&#205;MICOS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los componentes qu&#237;micos del guano de aves marinas son variables y dependen del sedimento del cual provienen, afectando su calidad como fertilizante.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d5">0</data>
      <data key="d6">529</data>
      <data key="d7">a923e6deed8848b8a01f89f532ad1425</data>
    </node>
    <node id="COSTAS ATL&#193;NTICAS">
      <data key="d0">HABITAT</data>
      <data key="d1">Las costas atl&#225;nticas son el h&#225;bitat donde se encuentran diversas especies de pinn&#237;pedos y aves marinas, incluyendo lobos marinos y cormoranes.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d5">0</data>
      <data key="d6">530</data>
      <data key="d7">4b4d297a9a1c4047a5a86c7b8353adde</data>
    </node>
    <node id="COSTAS DE TIERRA DEL FUEGO">
      <data key="d0">HABITAT</data>
      <data key="d1">Las costas de Tierra del Fuego son un h&#225;bitat importante para la reproducci&#243;n y descanso de lobos marinos y otras especies marinas.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d5">0</data>
      <data key="d6">531</data>
      <data key="d7">12cef71986744c8ab2d2961cadf1e57c</data>
    </node>
    <node id="AGENTES INFECCIOSOS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los agentes infecciosos son microorganismos que pueden causar enfermedades en los lobos marinos, aunque no se encontraron casos en la investigaci&#243;n.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d5">0</data>
      <data key="d6">532</data>
      <data key="d7">1841a499aa0c46ce88abf2d94f3bd746</data>
    </node>
    <node id="BALLENATOS">
      <data key="d0">MAMMAL</data>
      <data key="d1">Los ballenatos son cr&#237;as de ballenas que son enemigos naturales de los lobos marinos, especialmente la orca, que puede depredarlos.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d5">0</data>
      <data key="d6">533</data>
      <data key="d7">31305bb65e404e41b26b59ff7112d8a0</data>
    </node>
    <node id="LOBER&#205;AS CONTINENTALES">
      <data key="d0">HABITAT</data>
      <data key="d1">Las lober&#237;as continentales son &#225;reas costeras donde se agrupan colonias de lobos marinos, desempe&#241;ando un papel crucial en su reproducci&#243;n, alimentaci&#243;n y descanso. Estas zonas son esenciales para el ciclo de vida de los lobos marinos, ya que proporcionan un entorno seguro para la cr&#237;a y el desarrollo de las cr&#237;as, as&#237; como un lugar adecuado para que los adultos se alimenten y recuperen energ&#237;as. La conservaci&#243;n de estas lober&#237;as es vital para mantener la salud de las poblaciones de lobos marinos y, por ende, la biodiversidad marina en general.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d,8a0c5d2be39b9a9e02f97cbc7551030c</data>
      <data key="d3">97</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">534</data>
      <data key="d7">6a675a09f00d4fe9b841c5b19a3783ef</data>
    </node>
    <node id="LOBER&#205;AS EXTRA-CONTINENTALES">
      <data key="d0">HABITAT</data>
      <data key="d1">Las lober&#237;as extra-continentales son islas y roquer&#237;as que albergan grandes poblaciones de lobos marinos, as&#237; como &#225;reas marinas donde se encuentran colonias de estos mam&#237;feros marinos. Estas lober&#237;as son fundamentales para la conservaci&#243;n de los lobos marinos, ya que proporcionan h&#225;bitats esenciales para su reproducci&#243;n, alimentaci&#243;n y descanso. La protecci&#243;n de estas &#225;reas es crucial para asegurar la supervivencia de las especies de lobos marinos y mantener el equilibrio ecol&#243;gico en los ecosistemas marinos donde habitan.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d,8a0c5d2be39b9a9e02f97cbc7551030c</data>
      <data key="d3">97</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">535</data>
      <data key="d7">cdfc716fd4a04fb29c8eb19cb87ede1d</data>
    </node>
    <node id="CENSOS">
      <data key="d0">RESEARCH</data>
      <data key="d1">Los censos son recuentos peri&#243;dicos de la poblaci&#243;n de lobos marinos, utilizados para monitorear su n&#250;mero y distribuci&#243;n en diferentes h&#225;bitats.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d5">0</data>
      <data key="d6">536</data>
      <data key="d7">0dcbdc75bfe54e489a1f9e03fe082de0</data>
    </node>
    <node id="TALLAS EN LOBEZNOS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Las tallas en lobeznos reci&#233;n nacidos son medidas que indican su crecimiento y desarrollo durante los primeros d&#237;as de vida.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d5">0</data>
      <data key="d6">537</data>
      <data key="d7">2b8b7f9ba02a4b9e95cc2f85fb4d10c0</data>
    </node>
    <node id="PESOS EN LOBEZNOS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los pesos en lobeznos son datos que reflejan la salud y el desarrollo de las cr&#237;as de lobo marino durante sus primeras semanas.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d5">0</data>
      <data key="d6">538</data>
      <data key="d7">f11a2521120a49babedcf51ffbc40ff3</data>
    </node>
    <node id="LONGITUD DEL INTESTINO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">La longitud del intestino en lobos marinos adultos es un aspecto estudiado para entender su fisiolog&#237;a y dieta.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d5">0</data>
      <data key="d6">539</data>
      <data key="d7">2d2deba4b42b421bbac8dfb5958eaa56</data>
    </node>
    <node id="VOLUMEN DE SANGRE">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El volumen de sangre en lobos marinos adultos es un par&#225;metro importante para evaluar su salud y bienestar.)&lt;|COMPLETE|&gt;</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d5">0</data>
      <data key="d6">540</data>
      <data key="d7">4297109ecefb4941aa77b5db88abebb5</data>
    </node>
    <node id="APROVECHAMIENTO INDUSTRIAL">
      <data key="d0">NONE</data>
      <data key="d1">El aprovechamiento industrial de los pinn&#237;pedos incluye la obtenci&#243;n de cuero y aceite, regulado por varios decretos.</data>
      <data key="d2">2d041f866c2a7f149216961d43696c82</data>
      <data key="d3">26</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">541</data>
      <data key="d7">a19bb2913ef1483f85e20317b27279f8</data>
    </node>
    <node id="BAH&#205;AS SAN ANTONIO">
      <data key="d0">HABITAT</data>
      <data key="d1">Las Bah&#237;as San Antonio son un h&#225;bitat donde se encuentran colonias de lobos marinos de dos pelos, en el oc&#233;ano Atl&#225;ntico.</data>
      <data key="d2">2d041f866c2a7f149216961d43696c82</data>
      <data key="d3">97</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">542</data>
