    <node id="PUNTA QUIROGA">
      <data key="d0">NONE</data>
      <data key="d1">Punta Quiroga es un punto geogr&#225;fico en la Pen&#237;nsula Vald&#233;s, que forma parte de la entrada al Golfo San Jos&#233;, influyendo en la topograf&#237;a regional.</data>
      <data key="d2">a601887e8e26ca24bc383e59ed0bd947</data>
