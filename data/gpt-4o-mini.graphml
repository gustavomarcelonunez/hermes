    </node>
    <node id="PUNTA DEL BANCO">
      <data key="d0">NONE</data>
      <data key="d1">Punta del Banco es una ubicaci&#243;n geogr&#225;fica que se encuentra a 18 millas de Punta Lobos, caracterizada como un &#225;rea inexplotada.</data>
      <data key="d2">a601887e8e26ca24bc383e59ed0bd947</data>
