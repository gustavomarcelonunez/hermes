      <data key="d6">185</data>
      <data key="d7">52828289dc5b468a9b50bef0de9ffdef</data>
    </node>
    <node id="GOLFO SAN MAT&#205;AS">
      <data key="d0">NONE</data>
      <data key="d1">El Golfo San Mat&#237;as es un cuerpo de agua en la costa argentina, que se encuentra cerca de Punta Norte y es relevante para la ubicaci&#243;n de las lober&#237;as.</data>
      <data key="d2">a601887e8e26ca24bc383e59ed0bd947</data>
