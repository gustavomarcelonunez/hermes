      <data key="d7">38456918635a4ccfa3daaf369beab6ad</data>
    </node>
    <node id="TOPOGRAF&#205;A REGIONAL PUNTA BERMEJA">
      <data key="d0">NONE</data>
      <data key="d1">La topograf&#237;a regional de Punta Bermeja incluye una playa rocosa, acantilados y vegetaci&#243;n, que influye en el h&#225;bitat de los lobos marinos.</data>
      <data key="d2">a601887e8e26ca24bc383e59ed0bd947</data>
