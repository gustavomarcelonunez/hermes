    <node id="CARACTER&#205;STICAS POBLACI&#211;N LOBOS MARINOS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Las caracter&#237;sticas de la poblaci&#243;n de lobos marinos incluyen su n&#250;mero, distribuci&#243;n y comportamiento social en las lober&#237;as.</data>
