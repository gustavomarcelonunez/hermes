    </node>
    <node id="PUNTA VALD&#201;S">
      <data key="d0">HABITAT</data>
      <data key="d1">Punta Vald&#233;s es una ubicaci&#243;n en la costa N.E. donde se encuentra una concentraci&#243;n de elefantes marinos, conocida por su poblaci&#243;n de alrededor de 80 animales.</data>
      <data key="d2">acce0f2d52d35b868047d606555fc1e4</data>
