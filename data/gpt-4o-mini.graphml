    <node id="COSTAS ALTAS">
      <data key="d0">HABITAT</data>
      <data key="d1">Las costas altas son &#225;reas costeras que presentan barrancas a pique y son caracter&#237;sticas de ciertos h&#225;bitats donde se encuentran los lobos marinos.</data>
      <data key="d2">773258f4983ae1adc2e995e6a7bd7aa6</data>
