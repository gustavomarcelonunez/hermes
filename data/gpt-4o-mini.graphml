    <node id="EFICACIA">
      <data key="d0">NONE</data>
      <data key="d1">La eficacia se refiere a la capacidad de lograr un resultado deseado, en este caso, en la preparaci&#243;n de informes relacionados con la caza y el aprovechamiento industrial de especies marinas.</data>
      <data key="d2">4637827f6813c74937485d62b3f596b8</data>
