    <node id="ISLA GEORGIA DEL SUR">
      <data key="d0">HABITAT</data>
      <data key="d1">Isla Georgia del Sur es una isla en el Atl&#225;ntico Sur, conocida por ser un h&#225;bitat de elefantes marinos y otras especies marinas.</data>
