      <data key="d5">3</data>
      <data key="d6">174</data>
      <data key="d7">1325b7c7aa98407b9ee327390e7284a8</data>
    </node>
    <node id="LOBEZNOS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los lobeznos son las cr&#237;as de los lobos marinos, que dependen de sus madres para la alimentaci&#243;n y protecci&#243;n durante sus primeros meses de vida.</data>
      <data key="d2">acce0f2d52d35b868047d606555fc1e4</data>
      <data key="d5">0</data>
      <data key="d6">175</data>
      <data key="d7">52959ab8ff82482d909d79d6def5dbcb</data>
    </node>
    <node id="ARCHIPI&#201;LAGO TIERRA DEL FUEGO">
      <data key="d0">HABITAT</data>
      <data key="d1">El Archipi&#233;lago Tierra del Fuego es un h&#225;bitat donde se encuentran lobos marinos, con poblaciones tanto continentales como extra-continentales.</data>
      <data key="d2">acce0f2d52d35b868047d606555fc1e4</data>
      <data key="d3">114</data>
