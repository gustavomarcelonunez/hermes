    <node id="BAH&#205;A SANGUINETO">
      <data key="d0">NONE</data>
      <data key="d1">Bah&#237;a Sanguineto es una bah&#237;a ubicada en la Costa S. del Golfo de San Jorge, que sirve como un punto de referencia geogr&#225;fico.</data>
      <data key="d2">b936698b8bf77875919870e3152faf6d</data>
