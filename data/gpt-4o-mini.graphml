    </node>
    <node id="BAH&#205;A CAMARONES">
      <data key="d0">HABITAT</data>
      <data key="d1">Bah&#237;a Camarones es un h&#225;bitat donde se pueden observar ping&#252;inos comunes de Magallanes en su entorno natural.</data>
