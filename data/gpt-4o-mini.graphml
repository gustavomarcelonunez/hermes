    </node>
    <node id="ACEITE DE LOBO">
      <data key="d0">NONE</data>
      <data key="d1">El aceite de lobo es un producto derivado de los pinn&#237;pedos, utilizado en diversas aplicaciones industriales y comerciales.</data>
