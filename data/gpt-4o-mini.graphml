    <node id="ISLA ROCOSA">
      <data key="d0">HABITAT</data>
      <data key="d1">La isla rocosa es un h&#225;bitat de escasa altura que despide restinga en su parte sur, con costas suaves y terreno sin vegetaci&#243;n.</data>
      <data key="d2">59a2e76fa5cfb51e15d733d19084f125</data>
