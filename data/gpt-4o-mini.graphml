    </node>
    <node id="R&#205;O NEGRO">
      <data key="d0">NONE</data>
      <data key="d1">El R&#237;o Negro es un r&#237;o en Argentina, cuya desembocadura se encuentra cerca de la Lober&#237;a Punta Bermeja, influyendo en la topograf&#237;a regional.</data>
      <data key="d2">a601887e8e26ca24bc383e59ed0bd947</data>
