    </node>
    <node id="NIDIFICACI&#211;N DEL PING&#220;INO COM&#218;N">
      <data key="d0">REPRODUCTION</data>
      <data key="d1">La nidificaci&#243;n del ping&#252;ino com&#250;n es el proceso reproductivo que ocurre en zonas espec&#237;ficas, como la lober&#237;a &#8220;Monte Le&#243;n&#8221;, donde se encuentran &#225;reas de nidificaci&#243;n.</data>
      <data key="d2">773258f4983ae1adc2e995e6a7bd7aa6</data>
