      <data key="d0">HABITAT</data>
      <data key="d1">Bah&#237;a Vera es una bah&#237;a que alberga varios islotes y loberas, proporcionando un h&#225;bitat adecuado para los lobos marinos.</data>
      <data key="d2">cf58f0416a8d27360f6d6e772471b831</data>
