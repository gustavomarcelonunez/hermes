    <node id="TALLA, DETERMINACIONES">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">La talla y determinaciones en pinn&#237;pedos se refieren a las medidas y caracter&#237;sticas f&#237;sicas que se utilizan para identificar y clasificar las especies.</data>
      <data key="d2">9d8e3504b4ee32dcb2cfe65980dddcaa</data>
