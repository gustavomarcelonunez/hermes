    </node>
    <node id="ACEITE COM&#218;N NATURAL">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El aceite com&#250;n natural es un tipo de aceite de lobo marino que se utiliza como base para obtener aceite refinado.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
