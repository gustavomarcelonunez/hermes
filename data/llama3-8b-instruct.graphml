    </node>
    <node id="MINISTERIO DE AGRICULTURA">
      <data key="d0">NONE</data>
      <data key="d1">El Ministerio de Agricultura es el organismo responsable de regular y conceder permisos de caza de ping&#252;inos con fines de industrializaci&#243;n.</data>
      <data key="d2">ff2c7455e99e69b4239b601fef6b447e</data>
