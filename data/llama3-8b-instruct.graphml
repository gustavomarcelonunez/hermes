    <node id="ESTEARINA">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">La estearina es una sustancia que se extrae del aceite de lobo marino durante el proceso de refinado.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
