    <node id="ACIDEZ">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">La acidez es una caracter&#237;stica f&#237;sico-qu&#237;mica del aceite de lobo marino que var&#237;a seg&#250;n el tipo de aceite.</data>
