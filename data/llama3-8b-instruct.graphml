    </node>
    <node id="PESO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El peso es una caracter&#237;stica de los lobos marinos que se utiliza para determinar el rendimiento individual de aceite.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
