    <node id="PHYLLOBOTHRIMUM">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Phyllobothrium es un g&#233;nero de cestodos que infectan a los lobos marinos, encontrado en su tejido adiposo subcut&#225;neo.</data>
      <data key="d2">047fbbc658a3372904c9003df8fac928</data>
