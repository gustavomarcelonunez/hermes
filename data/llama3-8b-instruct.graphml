      <data key="d7">c1b5be69d01d45bab8ebbbc728b82f6b</data>
    </node>
    <node id="RESERVAS NATURALES">
      <data key="d0">HABITAT</data>
      <data key="d1">Las reservas naturales son &#225;reas protegidas donde se encuentran los ping&#252;inos comunes, declaradas para la conservaci&#243;n de esta especie animal.</data>
      <data key="d2">ff2c7455e99e69b4239b601fef6b447e</data>
      <data key="d3">7</data>
      <data key="d4">0</data>
