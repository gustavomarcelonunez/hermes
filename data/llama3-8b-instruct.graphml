      <data key="d7">293840dc3c3e49789b85dbfb20d8136a</data>
    </node>
    <node id="NEMATODOS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los nematodos son un tipo de par&#225;sito que infecta a los lobos marinos, encontrado en su est&#243;mago.</data>
      <data key="d2">047fbbc658a3372904c9003df8fac928</data>
      <data key="d3">16</data>
