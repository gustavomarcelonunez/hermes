      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Antarctophthirius es un g&#233;nero de piojos que infectan a los lobos marinos, encontrado en su pelaje.</data>
      <data key="d2">047fbbc658a3372904c9003df8fac928</data>
