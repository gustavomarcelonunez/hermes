      <data key="d7">f8ce090513314d2cbd5ea9839e79900f</data>
    </node>
    <node id="INVESTIGACIONES PARASITARIAS">
      <data key="d0">RESEARCH</data>
      <data key="d1">Las investigaciones parasitarias son estudios que se realizan para determinar la presencia de par&#225;sitos en los lobos marinos y su impacto en su salud.</data>
      <data key="d2">047fbbc658a3372904c9003df8fac928</data>
      <data key="d5">1</data>
      <data key="d6">7</data>
      <data key="d7">6554ebb28a7447f5991e60d87ec4705f</data>
    </node>
    <node id="MATERIALES FECALES">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Los materiales fecales son los desechos eliminados por los lobos marinos, que pueden ser utilizados para detectar la presencia de par&#225;sitos.</data>
      <data key="d2">047fbbc658a3372904c9003df8fac928</data>
      <data key="d5">1</data>
      <data key="d6">8</data>
      <data key="d7">c3807fac104840a0ac0fb58931bcc17c</data>
    </node>
    <node id="OTARIA FLAVESCENS">
      <data key="d0">SPECIES</data>
      <data key="d1">Otaria flavescens es una especie de lobo marino que habita en las costas de Am&#233;rica del Sur, caracterizada por su pelaje y su comportamiento social.</data>
      <data key="d2">047fbbc658a3372904c9003df8fac928</data>
      <data key="d3">15</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
