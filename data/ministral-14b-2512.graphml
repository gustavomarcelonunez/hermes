      <data key="d1">M&#233;todo usado para **atenuar el olor y sabor fuerte a narc&#243;ticos** de los huevos de ping&#252;ino, permitiendo su consumo por pobladores locales.</data>
      <data key="d2">efb532e66a85fbbd396d1e0031bc38c6</data>
      <data key="d3">154</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">1211</data>
      <data key="d7">a481cff6c2154c518617cabbb78aabe8</data>
    </node>
