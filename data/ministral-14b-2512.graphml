    <node id="BAH&#205;A SANGUINETO">
      <data key="d0">HABITAT</data>
      <data key="d1">Bah&#237;a Sanguineto es una zona costera con playas rocosas y mont&#237;culos, ubicada al este del Monte Loayza, que forma parte del ecosistema marino del Golfo de San Jorge.</data>
