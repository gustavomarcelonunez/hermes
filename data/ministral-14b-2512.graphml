    <node id="R&#201;GIMEN LEGAL">
      <data key="d0">CONSERVATION STATUS</data>
      <data key="d1">Marco normativo que regula la caza, pesca y explotaci&#243;n de especies marinas en Argentina, incluyendo permisos y sanciones.</data>
