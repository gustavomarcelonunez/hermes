    <node id="DEFENSA DEL TERRITORIO">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">Conducta territorial de machos adultos para proteger a sus haremes de intrusos, con reacciones agresivas ante amenazas.</data>
      <data key="d2">5d0b7d4c1666f60b16226f258041ff1e</data>
      <data key="d3">93</data>
      <data key="d4">1</data>
