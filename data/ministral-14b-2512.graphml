    <node id="ACEITE TIPO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Aceite de alta calidad obtenido del lobo marino, caracterizado por su aspecto turbio, color amarillo &#225;mbar, olor suave y baja acidez. Solidifica bajo 0&#176;C y tiene propiedades qu&#237;micas espec&#237;ficas como &#237;ndice de saponificaci&#243;n (178-196) e iodo (140-155).</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">87</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
