    <node id="ADAPTACI&#211;N AL AGUA">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">Proceso natural en los pichones, que **aprenden a nadar sin ense&#241;anza expl&#237;cita** desde sus primeros intentos, acompa&#241;ados por los progenitores.</data>
