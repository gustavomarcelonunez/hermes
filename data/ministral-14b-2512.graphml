    <node id="CAZA DE PING&#220;INOS">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">M&#233;todo de captura mediante golpes con bast&#243;n o ca&#241;o, causando muerte inmediata, similar a t&#233;cnicas usadas en lobos marinos.</data>
      <data key="d2">c0e82041e872b7b6fe0dc4899137a71d</data>
