    <node id="GRASA DE LOBO MARINO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Componente biol&#243;gico de alto valor comercial, extra&#237;do durante las matanzas para su procesamiento en plantas industriales.</data>
