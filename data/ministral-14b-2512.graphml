      <data key="d7">133fc772ff894613874cdc8d877533e0</data>
    </node>
    <node id="ORCA (ORSINUS ORCA MAGALLANICA)">
      <data key="d0">SPECIES</data>
      <data key="d1">La orca (Orsinus orca magall&#225;nica) es un depredador natural de los lobos marinos, especialmente de las cr&#237;as (ballenatos), en aguas del sur de Sudam&#233;rica.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
