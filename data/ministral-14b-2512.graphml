      <data key="d12">130</data>
      <data key="d13">3</data>
    </edge>
    <edge source="MIROUNGA LEONINA" target="LOCOMOCI&#211;N ACU&#193;TICA">
      <data key="d8">7.0</data>
      <data key="d9">mejor en</data>
      <data key="d10">18c940956aa73d7d33f5f00e41e092ec</data>
      <data key="d11">0f0792fbc7ee4014b53471e61d6e808b</data>
      <data key="d12">131</data>
