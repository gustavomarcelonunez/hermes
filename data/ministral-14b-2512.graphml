    <node id="FLORICULTURA">
      <data key="d0">MARINE ECOSYSTEM</data>
      <data key="d1">La floricultura es uno de los usos principales del guano de aves marinas como fertilizante en tierras cultivables.</data>
      <data key="d2">34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d3">279</data>
      <data key="d4">2</data>
