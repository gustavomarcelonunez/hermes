    </node>
    <node id="PESO DE CUEROS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Medida cuantitativa de los cueros obtenidos en la faena, que debe ser informada mensualmente.</data>
      <data key="d2">929b52dcc39f3e79e12fe7e15557dbaf</data>
