    <node id="INSTINTO DE CONSERVACI&#211;N">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">Reacciones naturales pospuestas durante el apareamiento, aumentando vulnerabilidad.</data>
      <data key="d2">5d0b7d4c1666f60b16226f258041ff1e</data>
