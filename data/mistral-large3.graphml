    <node id="EXPEDICIONES DE ESTUDIO">
      <data key="d0">RESEARCH</data>
      <data key="d1">Misiones de investigaci&#243;n realizadas entre 1946 y 1949 para estudiar pinn&#237;pedos, lober&#237;as y dep&#243;sitos de guano en costas e islas argentinas.</data>
      <data key="d2">4637827f6813c74937485d62b3f596b8</data>
