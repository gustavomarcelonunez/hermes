      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Etapa prenatal de la cr&#237;a, expulsado durante el parto con restos de cord&#243;n umbilical.</data>
      <data key="d2">a7319504eeb762ae0cc5b15c4d6b5461</data>
      <data key="d3">108</data>
      <data key="d4">1</data>
