    <node id="AEROFOTOGRAF&#205;A">
      <data key="d0">RESEARCH</data>
      <data key="d1">T&#233;cnica utilizada para documentar lober&#237;as y dep&#243;sitos de guano desde el aire, complementando el material fotogr&#225;fico terrestre.</data>
      <data key="d2">4637827f6813c74937485d62b3f596b8</data>
