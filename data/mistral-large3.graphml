    <node id="LEGISLACI&#211;N GUANERA">
      <data key="d0">CONSERVATION STATUS</data>
      <data key="d1">Normativas que regulan la explotaci&#243;n industrial del guano, protegiendo los yacimientos y su sostenibilidad.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d3">203</data>
