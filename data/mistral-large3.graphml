    <node id="ACEITE DE FOCA">
      <data key="d0">NONE</data>
      <data key="d1">Nombre gen&#233;rico con el que se conoce comercialmente al aceite de lobo marino.</data>
      <data key="d2">db8b432a978f4e34703f337510f8573d</data>
      <data key="d3">164</data>
      <data key="d4">2</data>
