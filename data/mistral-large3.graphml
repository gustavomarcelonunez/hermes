      <data key="d7">82449df8b03a46abab72e9a10a902826</data>
    </node>
    <node id="REUNI&#211;N MADRE-CR&#205;A">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">Mecanismos utilizados por la madre para reencontrarse con su cr&#237;a, como balidos y olfaci&#243;n, que permiten una identificaci&#243;n inequ&#237;voca.</data>
      <data key="d2">b58cdc05bb2d9dbcf563d7eaa562cf0f</data>
