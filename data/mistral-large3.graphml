    <node id="YACIMIENTOS DE GUANO">
      <data key="d0">HABITAT</data>
      <data key="d1">&#193;reas naturales con acumulaci&#243;n de guano, sujetas a explotaci&#243;n bajo el Decreto N&#176; 128730.</data>
