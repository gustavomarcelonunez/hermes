    <node id="COLONIA DE ELEFANTES MARINOS">
      <data key="d0">HABITAT</data>
      <data key="d1">&#218;nica colonia registrada en costas argentinas, ubicada en los 42&#176;07' S cerca de Punta Norte (Pen&#237;nsula Vald&#233;s), con pocos ejemplares de ambos sexos.</data>
      <data key="d2">b58cdc05bb2d9dbcf563d7eaa562cf0f</data>
