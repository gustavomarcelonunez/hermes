    <node id="GOTA">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Condici&#243;n m&#233;dica para la cual se usa el aceite de lobo marino como remedio tradicional.</data>
      <data key="d2">e2e07c1a5bead0187dec5149902c9499</data>
