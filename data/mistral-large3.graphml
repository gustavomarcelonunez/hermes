    </node>
    <node id="LOBER&#205;AS MIXTAS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Las lober&#237;as mixtas est&#225;n compuestas por individuos de ambos sexos, generalmente asociadas a colonias de procreo.</data>
      <data key="d2">00eb1b006d384f05258b2f105e84f309</data>
      <data key="d3">151</data>
