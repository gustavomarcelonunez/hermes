    <node id="PLAYAS ROCOSAS">
      <data key="d0">HABITAT</data>
      <data key="d1">Zonas costeras con piedras y canto rodado, t&#237;picas de lober&#237;as como "Caleta Chica" y "Cabo San Diego".</data>
      <data key="d2">12514c85e508ab1f8e976632806d74d6</data>
