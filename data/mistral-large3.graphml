    <node id="COMPORTAMIENTO DE REPOSO">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">Actitud de las aves guan&#237;feras cuando no buscan alimento, mostrando aparente letargo y tranquilidad en colonias.</data>
