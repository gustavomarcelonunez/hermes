    <node id="TEJIDO ADIPOSO SUBCUT&#193;NEO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Capa de grasa bajo la piel de los lobos marinos, donde se alojan endopar&#225;sitos como Tetrafilides.</data>
      <data key="d2">e2e07c1a5bead0187dec5149902c9499</data>
      <data key="d3">49</data>
