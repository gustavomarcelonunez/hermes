    <node id="POBLACI&#211;N TOTAL">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Cantidad total de lobos marinos registrada en cada lober&#237;a, incluyendo hembras, machos y cr&#237;as.</data>
