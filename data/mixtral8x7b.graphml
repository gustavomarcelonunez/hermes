      <data key="d4">416</data>
      <data key="d5">5f8b8453488e4f109894aaf629ac07f4</data>
    </node>
    <node id="COLOR BLANCO AMARILLANTE">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Color blanco amarillento is the color of the islote.)("relationship"</data>
      <data key="d2">94f4298857de42f37006e6e3561c06ee</data>
