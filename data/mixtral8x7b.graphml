      <data key="d4">451</data>
      <data key="d5">d37d675438a84f6ba3083498b9cdb465</data>
    </node>
    <node id="LOBER&#205;A &#8220;BAH&#205;A FLINDERS&#8221;">
      <data key="d0">POPULATION</data>
      <data key="d1">Lober&#237;a &#8220;Bah&#237;a Flinders&#8221; es una colonia de lobos marinos de dos pelos ubicada en la bah&#237;a Flinders, que alberga una poblaci&#243;n de 1500 lobos.</data>
      <data key="d2">0b772cca872bd1596e837c48e534ed7a</data>
