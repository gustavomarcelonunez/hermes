      <data key="d5">9e4f16adc7464245b32229c40c70dc18</data>
    </node>
    <node id="BARRILES">
      <data key="d0">MEASURE</data>
      <data key="d1">Los barriletes son una medida de la cantidad de aceite obtenido en la producci&#243;n industrial de elefantes marinos.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d6">71</data>
