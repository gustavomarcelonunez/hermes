      <data key="d5">1812aa61992b42c6870224c787ad80e5</data>
    </node>
    <node id="FARO BUEN SUCESO">
      <data key="d0">NONE</data>
      <data key="d1">El faro Buen Suceso es un faro que marca la entrada a la bah&#237;a Buen Suceso, cerca de la lober&#237;a del mismo nombre.</data>
      <data key="d2">2f4d4de1f51823e41ae13d66576539cb</data>
