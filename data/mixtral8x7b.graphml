    <node id="COPREFAGIA">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">La coprefagia es el h&#225;bito de comer excrementos, en este caso de lobos marinos, y es com&#250;n en las gaviotas.</data>
      <data key="d2">77e645beba0bf5256ed258f3fdd4a25e</data>
      <data key="d6">49</data>
      <data key="d7">1</data>
      <data key="d3">1</data>
