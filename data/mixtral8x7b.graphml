    <node id="BAH&#205;AS SAN ANTONIO Y FLINDERS">
      <data key="d0">HABITAT</data>
      <data key="d1">Bah&#237;as San Antonio y Flinders es el otro lugar donde se encuentra una colonia de lobos marinos de dos pelos extra-continentales.</data>
      <data key="d2">2d041f866c2a7f149216961d43696c82</data>
      <data key="d6">59</data>
