      <data key="d5">5c6342abd8cd43e7a926d2b29c0fac07</data>
    </node>
    <node id="AVES GUAN&#205;FERAS">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Aves guan&#237;feras son aves marinas que producen guano, conocidas com&#250;nmente como p&#225;jaros guaneros, cormoranes, biguaes o "Shag".</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d6">97</data>
      <data key="d7">1</data>
      <data key="d3">6</data>
      <data key="d4">756</data>
      <data key="d5">dec6e1b83fc4428499d4a9a1a860af4b</data>
    </node>
    <node id="PHALACROCORACIDEOS">
      <data key="d0">NONE</data>
      <data key="d1">Phalacrocoracideos es una familia de aves marinas que incluye a los cormoranes y biguaes.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d6">97</data>
