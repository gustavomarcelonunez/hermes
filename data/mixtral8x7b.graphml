      <data key="d4">753</data>
      <data key="d5">9436ca22e22b44139720f6cd852bfbe1</data>
    </node>
    <node id="PRODUCCI&#211;N GUANERA">
      <data key="d0">NONE</data>
      <data key="d1"> "PRODUCCI&#211;N GUANERA" se refiere a la cantidad de guano producido por aves marinas durante un determinado per&#237;odo de tiempo.

(Translation): "GUANO PRODUCTION" refers to the amount of guano produced by marine birds in a given period of time.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0,ff2c7455e99e69b4239b601fef6b447e</data>
