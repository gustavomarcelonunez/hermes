    <node id="COSTA S. DEL GOLFO DE SAN JORGE">
      <data key="d0">HABITAT</data>
      <data key="d1">Costa localizada en el sur de Argentina, caracterizada por playas rocosas, mont&#237;culos y restinga, con barrancas de poca altura y tierra arcillosa.</data>
      <data key="d2">b936698b8bf77875919870e3152faf6d</data>
