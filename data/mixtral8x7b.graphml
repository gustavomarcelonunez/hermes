    </node>
    <node id="BAH&#205;A THETIS">
      <data key="d0">HABITAT</data>
      <data key="d1"> "Bah&#237;a Thetis is a habitat located in Tierra del Fuego, Argentina, known for the exploitation of sea lions and elephant seals. This bah&#237;a is situated in the southeast coast of Tierra del Fuego and is recognized for its abundant marine life and the presence of several sea lion colonies."</data>
      <data key="d2">12514c85e508ab1f8e976632806d74d6,fee8446145e958ff9402203e372df57d</data>
      <data key="d6">55</data>
