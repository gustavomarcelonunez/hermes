    <node id="BAH&#205;A GRANDE">
      <data key="d0">HABITAT</data>
      <data key="d1">Bah&#237;a Grande es una bah&#237;a ubicada en la provincia de Santa Cruz, Argentina, conocida por su riqueza en fauna marina y su importancia como h&#225;bitat para diferentes especies.</data>
      <data key="d2">773258f4983ae1adc2e995e6a7bd7aa6</data>
