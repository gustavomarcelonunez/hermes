      <data key="d3">2</data>
      <data key="d4">242</data>
      <data key="d5">cc8c6eb2c80b4c989664ae530eef333b</data>
    </node>
    <node id="MARCAS">
      <data key="d0">NONE</data>
      <data key="d1">Las marcas son se&#241;ales o identificadores utilizados en los lobos marinos, como una letra "C" o "A", para estudiar su comportamiento y movimientos.</data>
      <data key="d2">77e645beba0bf5256ed258f3fdd4a25e</data>
      <data key="d6">57</data>
