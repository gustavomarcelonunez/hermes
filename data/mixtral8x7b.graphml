    <node id="LOBER&#205;A &#8220;BAH&#205;A CROSSLEY&#8221;">
      <data key="d0">POPULATION</data>
      <data key="d1">Lober&#237;a &#8220;Bah&#237;a Crossley&#8221; es una colonia de lobos marinos de dos pelos ubicada en Bah&#237;a Crossley, que alberga una poblaci&#243;n de 500 lobos.</data>
      <data key="d2">0b772cca872bd1596e837c48e534ed7a</data>
