      <data key="d3">7</data>
      <data key="d4">317</data>
      <data key="d5">7c0eded743e04e2fbf1125adf12ab809</data>
    </node>
    <node id="ISLA BLANCA ESTE">
      <data key="d0">HABITAT</data>
      <data key="d1">Isla rocosa de escasa altura, sin vegetaci&#243;n, ubicada en el centro de la Bah&#237;a Camarones, al N.E. de Punta Albatros, con longitudes de 450 metros por 200 metros. Permanente, mixto, parici&#243;n, inexplotado.</data>
