    <edge source="FRONTONES" target="AVES">
      <data key="d8">18.0</data>
      <data key="d9"> Los Frontones son utilizados por las aves para anidar. (The Frontones are used by birds for nesting.)</data>
      <data key="d10">3b8a637af69ae3ba996edaf49f1ed1f0</data>
