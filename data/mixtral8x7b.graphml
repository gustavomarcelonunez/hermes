      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">Barrancas sin altura, de pendiente suave, que cubren las costas y est&#225;n rodeadas de vegetaci&#243;n t&#237;pica.</data>
      <data key="d2">e411653fa84230bcd9ca8f9b38657cca</data>
