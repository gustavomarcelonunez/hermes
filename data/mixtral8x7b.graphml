      <data key="d4">304</data>
      <data key="d5">999b1a1f1af04c0bbcc2e283567bb2ec</data>
    </node>
    <node id="ISLOTE SURESTE DE PUNTA LOBER&#205;A">
      <data key="d0">HABITAT</data>
      <data key="d1">El Islote Sureste de Punta Lober&#237;a es un h&#225;bitat de permanencia, mixto y de parici&#243;n para los lobos marinos de dos pelos, situado en la Bah&#237;a Vera y no visible desde la costa.</data>
      <data key="d2">cf58f0416a8d27360f6d6e772471b831</data>
