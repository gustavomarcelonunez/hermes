    </node>
    <node id="CABO TRES PUNTAS">
      <data key="d0">NONE</data>
      <data key="d1">Punto de referencia en la costa sur de Argentina, utilizado para describir la distancia a la costa S. del Golfo de San Jorge y al Monte Loayza.</data>
