      <data key="d4">642</data>
      <data key="d5">cbe8afbef5e6401886e5a68ca42a1125</data>
    </node>
    <node id="PERSONAS O EMPRESAS INTERESADAS">
      <data key="d0">NONE</data>
      <data key="d1">Sujetos que desean obtener permisos para cazar e industrializar ciertas especies de pinn&#237;pedos en territorios de la Naci&#243;n.</data>
      <data key="d2">c189d2e78df197f5464424712ff00b40</data>
      <data key="d6">72</data>
      <data key="d7">1</data>
      <data key="d3">2</data>
