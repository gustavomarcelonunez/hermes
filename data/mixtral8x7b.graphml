      <data key="d5">fdb6cb8bc66147de802aa768ae9616fc</data>
    </node>
    <node id="OBSERVACIONES COPROL&#211;GICAS">
      <data key="d0">RESEARCH</data>
      <data key="d1">Las observaciones coprol&#243;gicas son estudios de las heces de los lobos marinos, que pueden proporcionar informaci&#243;n sobre su dieta, salud y comportamiento.</data>
      <data key="d2">9d8e3504b4ee32dcb2cfe65980dddcaa</data>
      <data key="d3">1</data>
