    <node id="LOTE PUNTUDO">
      <data key="d0">NONE</data>
      <data key="d1">Lote Puntudo es un islote rocoso ubicado en las coordenadas 48&#176; 7&#8217; 3&#8221; S, 66&#176; 3&#8217; 12&#8221; W, a 1600 metros de la costa. Tiene un di&#225;metro de alrededor de 300 metros y una topograf&#237;a regional de costa que proyecta restinga, sin vegetaci&#243;n y de color blanco amarillento.</data>
      <data key="d2">94f4298857de42f37006e6e3561c06ee</data>
      <data key="d3">0</data>
      <data key="d4">414</data>
      <data key="d5">f4d626b44af648569e522bbb8229ba21</data>
    </node>
    <node id="DISTANCIA A LA COSTA">
      <data key="d0">HABITAT</data>
      <data key="d1">Islote Puntudo se encuentra a una distancia de 1600 metros de la costa.</data>
      <data key="d2">94f4298857de42f37006e6e3561c06ee</data>
