      <data key="d5">77e31d056b074e49bc9e8c9af0b6a09c</data>
    </node>
    <node id="UNIDADES DE CUERO">
      <data key="d0">MEASURE</data>
      <data key="d1">Las unidades de cuero son una medida de la cantidad de cueros de lobos marinos o elefantes marinos obtenidos en la producci&#243;n industrial.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d6">73</data>
      <data key="d7">1</data>
      <data key="d3">1</data>
      <data key="d4">614</data>
      <data key="d5">982095c761c1487f908ebaa1f38dd22c</data>
    </node>
    <node id="KILOGRAMOS DE ACEITE">
      <data key="d0">MEASURE</data>
      <data key="d1">Los kilogramos de aceite son una medida de la cantidad de aceite obtenido en la producci&#243;n industrial de lobos marinos o elefantes marinos.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d6">73</data>
      <data key="d7">1</data>
