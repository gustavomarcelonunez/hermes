      <data key="d5">1a06a760a9484e0a95ad29c26140870a</data>
    </node>
    <node id="FICHADO">
      <data key="d0">BIOLOGICAL CHARACTERISTICS</data>
      <data key="d1">El fichado es el proceso de obtenci&#243;n de grasa de los lobos marinos para la producci&#243;n de aceite.</data>
      <data key="d2">2d041f866c2a7f149216961d43696c82</data>
      <data key="d3">1</data>
      <data key="d4">906</data>
      <data key="d5">39c1016a76454687abeb0acb66a358a8</data>
    </node>
    <node id="SALAZ&#211;N SECA">
      <data key="d0">CONSERVATION STATUS</data>
      <data key="d1">La salaz&#243;n seca es el m&#233;todo de conservaci&#243;n de los cueros de lobos marinos para su empleo en talabarter&#237;a y peleter&#237;a.</data>
      <data key="d2">2d041f866c2a7f149216961d43696c82</data>
      <data key="d3">1</data>
      <data key="d4">907</data>
      <data key="d5">d63124f7dbfb4526a1e7768d75c0f2da</data>
    </node>
    <node id="CURTIR&#205;A">
      <data key="d0">BEHAVIOR</data>
      <data key="d1">La curtir&#237;a es el uso del aceite de los lobos marinos en la industria de curtido de pieles.</data>
      <data key="d2">2d041f866c2a7f149216961d43696c82</data>
      <data key="d3">1</data>
      <data key="d4">908</data>
      <data key="d5">8dc6a7a886ee44bbaff86273a3be8178</data>
    </node>
