      <data key="d3">4</data>
      <data key="d4">577</data>
      <data key="d5">35e0dd46589d4dc2a717f40a61294e3f</data>
    </node>
    <node id="PEJERREYES">
      <data key="d0">SPECIES</data>
      <data key="d1">Pejerreyes que se alimentan de los restos de la materia prima utilizada en el proceso de obtenci&#243;n de aceite.</data>
      <data key="d2">c5a1c4c74e983a59cf199b4e8dbe6265</data>
      <data key="d6">29</data>
      <data key="d7">1</data>
