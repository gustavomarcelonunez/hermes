    <node id="CABO BEAULIEN">
      <data key="d0">HABITAT</data>
      <data key="d1">Cabo Beaulien es un cabo ubicado en la isla de los Estados, que sirve como punto de referencia para la ubicaci&#243;n de la Lober&#237;a &#8220;Bah&#237;a Flinders&#8221;.</data>
