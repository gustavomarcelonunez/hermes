    <node id="LOBER&#205;A &#8220;BAH&#205;A VALENT&#205;N&#8221;">
      <data key="d0">HABITAT</data>
      <data key="d1">Lober&#237;a Bah&#237;a Valent&#237;n es una zona de cr&#237;a y parto de lobos marinos, ubicada en la costa oriental de la bah&#237;a inmediatamente al Norte de Punta Blanca.</data>
      <data key="d2">a4db5e0e4291abc5a30297f97a8ac533</data>
      <data key="d6">111</data>
      <data key="d7">2</data>
