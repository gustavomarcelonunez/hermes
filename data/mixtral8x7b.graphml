    </node>
    <node id="FARO SANTA CRUZ">
      <data key="d0">NONE</data>
      <data key="d1">El faro Santa Cruz es una estructura costera ubicada en la entrada del r&#237;o del mismo nombre, en la provincia de Santa Cruz, Argentina.</data>
      <data key="d2">773258f4983ae1adc2e995e6a7bd7aa6</data>
