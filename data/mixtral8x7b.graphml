    <node id="CUERO DE ELEFANTES MARINOS">
      <data key="d0">PRODUCT</data>
      <data key="d1">El cuero de elefantes marinos es un producto obtenido a partir de la piel de los elefantes marinos, y se emplea en la industria del cuero.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d6">71</data>
