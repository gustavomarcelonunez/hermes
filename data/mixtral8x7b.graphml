      <data key="d4">449</data>
      <data key="d5">8c18be66ce6b4ce4bcccaffbb12ea5aa</data>
    </node>
    <node id="PUNTA ESTE SIN NOMBRE">
      <data key="d0">HABITAT</data>
      <data key="d1">Punta Este Sin Nombre es una punta de tierra ubicada en la costa sureste de Bah&#237;a Thetis, donde se encuentran varias lober&#237;as.</data>
      <data key="d2">12514c85e508ab1f8e976632806d74d6</data>
      <data key="d3">0</data>
      <data key="d4">450</data>
      <data key="d5">dc4864539dd541749c33a318700217a1</data>
    </node>
    <node id="TIERRA DEL FUEGO">
      <data key="d0" />
      <data key="d1"> Tierra del Fuego is a group of islands located in the extreme southernmost region of Argentina and Chile, encompassing a diverse and remote landscape that includes mountains, forests, and a wide range of marine ecosystems.</data>
      <data key="d2">12514c85e508ab1f8e976632806d74d6,34798580ffa1eeacedf7b69c5f9ef85d</data>
      <data key="d6">55</data>
