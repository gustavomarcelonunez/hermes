      <data key="d3">1</data>
      <data key="d4">645</data>
      <data key="d5">1a11f521a44b4213abca2a45ac2c2d62</data>
    </node>
    <node id="ACEITES Y SUBPRODUCTOS DE PINN&#205;PEDOS">
      <data key="d0">NONE</data>
      <data key="d1">Productos prohibidos en desembarcos en puertos del pa&#237;s, seg&#250;n el decreto presidencial.</data>
      <data key="d2">c189d2e78df197f5464424712ff00b40</data>
