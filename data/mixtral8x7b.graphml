    </node>
    <node id="MIRONGA LEONINA">
      <data key="d0">SPECIES</data>
      <data key="d1">Mirounga Leonina es una especie de elefante marino, que habita en las costas del hemisferio sur.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d6">71</data>
      <data key="d7">1</data>
      <data key="d3">1</data>
      <data key="d4">617</data>
      <data key="d5">dc87dec4463a4ce29e29455383928acd</data>
    </node>
    <node id="TERRITORIO">
      <data key="d0">HABITAT</data>
      <data key="d1">El Territorio es el h&#225;bitat natural de los lobos marinos y elefantes marinos, y se encuentra en las costas del hemisferio sur.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d6">73</data>
      <data key="d7">1</data>
      <data key="d3">1</data>
      <data key="d4">618</data>
      <data key="d5">932254e4bfea427e8e9b667fe5bf0ff7</data>
    </node>
    <node id="ISLAS GEORGIAS DEL SUR">
      <data key="d0">HABITAT</data>
      <data key="d1">Las Islas Georgias del Sur son un h&#225;bitat natural de los lobos marinos y elefantes marinos, y se encuentran en el oc&#233;ano Atl&#225;ntico sur.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d6">71</data>
      <data key="d7">1</data>
      <data key="d3">1</data>
      <data key="d4">619</data>
      <data key="d5">95d1ac15de3a4987868c68731dce7864</data>
    </node>
    <node id="C&#205;A. ARGENTINA DE PESCA S.A.">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">La C&#237;a. Argentina de Pesca S.A. es una organizaci&#243;n que se dedica a la pesca y caza mar&#237;tima en las Islas Georgias del Sur, y es la encargada de la producci&#243;n industrial de lobos marinos y elefantes marinos en la regi&#243;n.</data>
      <data key="d2">08e9f4bcb8bee78292601780a46936c6</data>
      <data key="d6">73</data>
      <data key="d7">1</data>
      <data key="d3">1</data>
