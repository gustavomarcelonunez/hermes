    </node>
    <node id="ISLOTE SUROESTE DE CABO SAN JOS&#201;">
      <data key="d0">HABITAT</data>
      <data key="d1">El Islote Suroeste de Cabo San Jos&#233; es un h&#225;bitat permanente, mixto y de parici&#243;n para los lobos marinos de dos pelos, situado en la Pen&#237;nsula de Betbeder y unido al continente en bajamar.</data>
      <data key="d2">cf58f0416a8d27360f6d6e772471b831</data>
      <data key="d6">59</data>
      <data key="d7">1</data>
      <data key="d3">1</data>
      <data key="d4">306</data>
