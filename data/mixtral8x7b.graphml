    <node id="LOBERAS">
      <data key="d0">HABITAT</data>
      <data key="d1">Loberas son los lugares donde viven los lobos marinos, ubicadas entre los 39&#176; 14' y 54&#176; 58' de latitud sur.</data>
      <data key="d2">2d041f866c2a7f149216961d43696c82</data>
