    <node id="MINISTERIO DE AGRICULTURA Y GANADER&#205;A">
      <data key="d0">NONE</data>
      <data key="d1">El Ministerio de Agricultura y Ganader&#237;a es una entidad gubernamental encargada de regular y promover las actividades agropecuarias y ganaderas en el pa&#237;s.</data>
      <data key="d2">9d8e3504b4ee32dcb2cfe65980dddcaa</data>
