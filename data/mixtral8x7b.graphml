    <node id="FRANCIA">
      <data key="d0">COUNTRY</data>
      <data key="d1">Francia es un pa&#237;s en Europa, donde se han exportado cueros de ping&#252;inos.</data>
      <data key="d2">ff2c7455e99e69b4239b601fef6b447e</data>
