    <node id="SAN JULI&#193;N">
      <data key="d0">HABITAT</data>
      <data key="d1">San Juli&#225;n es una ubicaci&#243;n geogr&#225;fica en las costas de Sudam&#233;rica, donde se han llevado a cabo faenas de caza de ping&#252;inos.</data>
      <data key="d2">ff2c7455e99e69b4239b601fef6b447e</data>
