    <node id="FARO LE MAIRE">
      <data key="d0">HABITAT</data>
      <data key="d1">Faro Le Maire es un faro ubicado en la entrada de la Bah&#237;a Crossley, que sirve como punto de referencia para la ubicaci&#243;n de la Lober&#237;a &#8220;Bah&#237;a Crossley&#8221;.</data>
      <data key="d2">0b772cca872bd1596e837c48e534ed7a</data>
