      <data key="d3">1</data>
      <data key="d4">757</data>
      <data key="d5">acd49ad134b7436d8129fa40e50c4641</data>
    </node>
    <node id="PELECANIFORMES">
      <data key="d0">NONE</data>
      <data key="d1">Pelecaniformes es un orden de aves marinas que incluye a los cormoranes, pel&#237;canos y otras aves acu&#225;ticas.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d6">97</data>
      <data key="d7">1</data>
      <data key="d3">1</data>
      <data key="d4">758</data>
      <data key="d5">984e61459ca345de8fd8d2cd71797234</data>
    </node>
    <node id="CORMOR&#193;N DE MAGALLANES">
      <data key="d0">SPECIES</data>
      <data key="d1">El Cormor&#225;n de Magallanes (Phalacrocorax Magellanicus) es una especie de ave marina que habita en las costas de Chile y Argentina.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d6">97</data>
      <data key="d7">1</data>
      <data key="d3">1</data>
      <data key="d4">759</data>
      <data key="d5">2ab9d4152ea84a2e9ad51b1320a68381</data>
    </node>
    <node id="CORMOR&#193;N GRIS">
      <data key="d0">SPECIES</data>
      <data key="d1">El Cormor&#225;n gris (Phalacrocorax gaimardi) es una especie de ave marina que habita en las costas de Chile y Per&#250;.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d6">97</data>
      <data key="d7">1</data>
      <data key="d3">1</data>
      <data key="d4">760</data>
      <data key="d5">0766021c6ee746a3acbc3dc9ccadb89f</data>
    </node>
    <node id="CORMOR&#193;N">
      <data key="d0">SPECIES</data>
      <data key="d1">El Cormor&#225;n (Phalacrocorax Albiventer) es una especie de ave marina que habita en las costas de Chile y Per&#250;.</data>
      <data key="d2">3b8a637af69ae3ba996edaf49f1ed1f0</data>
      <data key="d6">97</data>
      <data key="d7">1</data>
