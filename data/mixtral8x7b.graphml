      <data key="d5">b3196362fa884c0ca7fcabdff37bbee9</data>
    </node>
    <node id="ISLOTE DE LOS ESTADOS">
      <data key="d0">HABITAT</data>
      <data key="d1">El Islote de los Estados es un h&#225;bitat de lobos marinos ubicado en la bah&#237;a San Antonio, entre Cabo Colnett y Cabo San Antonio.</data>
      <data key="d2">12514c85e508ab1f8e976632806d74d6</data>
      <data key="d6">55</data>
      <data key="d7">1</data>
      <data key="d3">4</data>
      <data key="d4">447</data>
